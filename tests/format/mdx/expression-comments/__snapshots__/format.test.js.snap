exports[`leading-comment.mdx - {"embeddedLanguageFormatting":"off"} format 1`] = `
====================================options=====================================
embeddedLanguageFormatting: "off"
parsers: ["mdx"]
                                                      printWidth: 80 (default) |
=====================================input======================================
{
/**
 * leading JSDoc
 */
foo()}

{// leading line comment
foo()}

text {/* leading */ foo()} text

text {
// leading line comment in text expression
foo()
} text

=====================================output=====================================
{/**
* leading JSDoc
*/
foo()}

{
// leading line comment
foo()
}

text {/* leading */ foo()} text

text {
// leading line comment in text expression
foo()
} text

================================================================================
`;

