exports[`nested-comment.mdx - {"embeddedLanguageFormatting":"off"} format 1`] = `
====================================options=====================================
embeddedLanguageFormatting: "off"
parsers: ["mdx"]
                                                      printWidth: 80 (default) |
=====================================input======================================
{foo(
// nested comment
bar
)}

{/**
 * leading
 */ [/* inner */]}

{[/* inner */] /**
 * trailing
 */}

{/**
 * leading
 */ foo(/* inner */)}

{({/* inner */}) /**
 * trailing
 */}

{[// inner
]}

=====================================output=====================================
{
foo(
// nested comment
bar
)
}

{/**
* leading
*/ [/* inner */]}

{[/* inner */] /**
* trailing
*/}

{/**
* leading
*/ foo(/* inner */)}

{({/* inner */}) /**
* trailing
*/}

{
[// inner
]
}

================================================================================
`;

