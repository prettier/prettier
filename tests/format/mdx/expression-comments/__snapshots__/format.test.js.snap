exports[`comment-only.mdx - {"embeddedLanguageFormatting":"off"} format 1`] = `
====================================options=====================================
embeddedLanguageFormatting: "off"
parsers: ["mdx"]
                                                      printWidth: 80 (default) |
=====================================input======================================
{
// only a line comment
}

{
// first
// second
}

{/* block */
// then line
}

{// line
/* then block */}

text {
// line comment in text expression
} text

{/* block comment only */}

=====================================output=====================================
{
// only a line comment
}

{
// first
// second
}

{
/* block */
// then line
}

{
// line
/* then block */
}

text {
// line comment in text expression
} text

{/* block comment only */}

================================================================================
`;

