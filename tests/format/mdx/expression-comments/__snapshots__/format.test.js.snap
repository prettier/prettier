exports[`trailing-comment.mdx - {"embeddedLanguageFormatting":"off"} format 1`] = `
====================================options=====================================
embeddedLanguageFormatting: "off"
parsers: ["mdx"]
                                                      printWidth: 80 (default) |
=====================================input======================================
{
/**
 * some JSDoc
 */
here.is.some.expression()

/**
 * @param {unknown} x
 */}
export function f(x) {}

{foo()
// trailing line comment
}

{foo() // same line comment
}

<A b={foo()
// trailing in attribute
} />

text {foo()
// trailing in text expression
} text

{foo() /* same line block comment stays */}

<Wrapper>
{foo()
// trailing inside JSX children
}
</Wrapper>

=====================================output=====================================
{/**
* some JSDoc
*/
here.is.some.expression()

/**
* @param {unknown} x
*/}

export function f(x) {}

{
foo()
// trailing line comment
}

{
foo() // same line comment
}

<A b={foo()
// trailing in attribute
} />

text {
foo()
// trailing in text expression
} text

{foo() /* same line block comment stays */}

<Wrapper>
  {
  foo()
// trailing inside JSX children
  }
</Wrapper>

================================================================================
`;

