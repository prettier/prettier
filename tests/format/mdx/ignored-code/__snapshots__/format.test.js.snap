exports[`basic.mdx format 1`] = `
====================================options=====================================
parsers: ["mdx"]
                                                      printWidth: 80 (default) |
=====================================input======================================
<div>

{/* prettier-ignore */}
\`\`\`js
function f() {
  return 1;
}
\`\`\`

{/* prettier-ignore */}
\`\`\`python
if True:
    print("still indented")
\`\`\`

</div>

=====================================output=====================================
<div>
  {/* prettier-ignore */}
  \`\`\`js
  function f() {
    return 1;
  }
  \`\`\`

  {/* prettier-ignore */}
  \`\`\`python
  if True:
      print("still indented")
  \`\`\`
</div>

================================================================================
`;

exports[`containers.mdx format 1`] = `
====================================options=====================================
parsers: ["mdx"]
                                                      printWidth: 80 (default) |
=====================================input======================================
<Outer>
    <Inner>

    {/* prettier-ignore */}
    \`\`\`python
    if True:
        print("nested JSX")
    \`\`\`

    </Inner>
</Outer>

1. List

   <Component>

   {/* prettier-ignore */}
   \`\`\`python
   if True:
       print("inside a list")
   \`\`\`

   </Component>

> <Component>
>
> {/* prettier-ignore */}
> \`\`\`python
> if True:
>     print("inside a block quote")
> \`\`\`
>
> </Component>

=====================================output=====================================
<Outer>
  <Inner>
    {/* prettier-ignore */}
    \`\`\`python
    if True:
        print("nested JSX")
    \`\`\`
  </Inner>
</Outer>

1. List

   <Component>
     {/* prettier-ignore */}
     \`\`\`python
     if True:
         print("inside a list")
     \`\`\`
   </Component>

> <Component>
>   {/* prettier-ignore */}
>   \`\`\`python
>   if True:
>       print("inside a block quote")
>   \`\`\`
> </Component>

================================================================================
`;

exports[`fences.mdx format 1`] = `
====================================options=====================================
parsers: ["mdx"]
                                                      printWidth: 80 (default) |
=====================================input======================================
<Component>

{/* prettier-ignore */}
~~~~  python title="example"
if True:
    print("keep the fence and info string")
~~~~~~

{/* prettier-ignore */}
\`\`\`\`js
const value = \`first
  second\`;
\`\`\`\`\`

{/* prettier-ignore */}
\`\`\`
\`\`\`

{/* prettier-ignore */}
\`\`\`

\`\`\`

{/* prettier-ignore */}
\`\`\`


\`\`\`

</Component>

=====================================output=====================================
<Component>
  {/* prettier-ignore */}
  ~~~~  python title="example"
  if True:
      print("keep the fence and info string")
  ~~~~~~

  {/* prettier-ignore */}
  \`\`\`\`js
  const value = \`first
    second\`;
  \`\`\`\`\`

  {/* prettier-ignore */}
  \`\`\`
  \`\`\`

  {/* prettier-ignore */}
  \`\`\`
  
  \`\`\`

  {/* prettier-ignore */}
  \`\`\`
  
  
  \`\`\`
</Component>

================================================================================
`;

