exports[`xml-space.vue format 1`] = `
====================================options=====================================
parsers: ["vue"]
                                                      printWidth: 80 (default) |
=====================================input======================================
<template>
  <svg xml:space="preserve"><text>  {{message+  suffix}} <tspan>  spaces  </tspan></text></svg>
