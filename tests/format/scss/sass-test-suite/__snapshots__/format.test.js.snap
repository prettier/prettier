exports[`snippet: non_conformant/extend-tests/escaped_selector.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
// Escapes in selectors' identifiers should be normalized before \`@extend\` is
// applied.
.foo {escape: none}
\\.foo {escape: slash dot}
\\2E foo {escape: hex}

.bar {@extend \\02e foo}

=====================================output=====================================
// Escapes in selectors' identifiers should be normalized before \`@extend\` is
// applied.
.foo {
  escape: none;
}
\\.foo {
  escape: slash dot;
}
\\2E foo {
  escape: hex;
}

.bar {
  @extend \\02e foo;
}

================================================================================
`;

exports[`snippet: non_conformant/extend-tests/extend-extender.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
// For implementations like Dart Sass that process extensions as they occur,
// extending rules that contain their own extends needs special handling.
.b {@extend .a}
.c {@extend .b}
.a {x: y}

=====================================output=====================================
// For implementations like Dart Sass that process extensions as they occur,
// extending rules that contain their own extends needs special handling.
.b {
  @extend .a;
}
.c {
  @extend .b;
}
.a {
  x: y;
}

================================================================================
`;

exports[`snippet: non_conformant/extend-tests/extend-loop.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
// Make sure extend loops are handled correctly. Test in all different orderings
// so we can be sure this works for implementations like Dart Sass where extend
// order matters.

@media order1 {
  .x1.y1.a1 {x: y; @extend .b1}
  .z1.b1 {x: y; @extend .c1}
  .c1 {x: y; @extend .a1}
}

@media order2 {
  .x2.y2.a2 {x: y; @extend .b2}
  .c2 {x: y; @extend .a2}
  .z2.b2 {x: y; @extend .c2}
}

@media order3 {
  .z3.b3 {x: y; @extend .c3}
  .x3.y3.a3 {x: y; @extend .b3}
  .c3 {x: y; @extend .a3}
}

@media order4 {
  .z4.b4 {x: y; @extend .c4}
  .c4 {x: y; @extend .a4}
  .x4.y4.a4 {x: y; @extend .b4}
}

@media order5 {
  .c5 {x: y; @extend .a5}
  .z5.b5 {x: y; @extend .c5}
  .x5.y5.a5 {x: y; @extend .b5}
}

@media order6 {
  .c6 {x: y; @extend .a6}
  .x6.y6.a6 {x: y; @extend .b6}
  .z6.b6 {x: y; @extend .c6}
}

=====================================output=====================================
// Make sure extend loops are handled correctly. Test in all different orderings
// so we can be sure this works for implementations like Dart Sass where extend
// order matters.

@media order1 {
  .x1.y1.a1 {
    x: y;
    @extend .b1;
  }
  .z1.b1 {
    x: y;
    @extend .c1;
  }
  .c1 {
    x: y;
    @extend .a1;
  }
}

@media order2 {
  .x2.y2.a2 {
    x: y;
    @extend .b2;
  }
  .c2 {
    x: y;
    @extend .a2;
  }
  .z2.b2 {
    x: y;
    @extend .c2;
  }
}

@media order3 {
  .z3.b3 {
    x: y;
    @extend .c3;
  }
  .x3.y3.a3 {
    x: y;
    @extend .b3;
  }
  .c3 {
    x: y;
    @extend .a3;
  }
}

@media order4 {
  .z4.b4 {
    x: y;
    @extend .c4;
  }
  .c4 {
    x: y;
    @extend .a4;
  }
  .x4.y4.a4 {
    x: y;
    @extend .b4;
  }
}

@media order5 {
  .c5 {
    x: y;
    @extend .a5;
  }
  .z5.b5 {
    x: y;
    @extend .c5;
  }
  .x5.y5.a5 {
    x: y;
    @extend .b5;
  }
}

@media order6 {
  .c6 {
    x: y;
    @extend .a6;
  }
  .x6.y6.a6 {
    x: y;
    @extend .b6;
  }
  .z6.b6 {
    x: y;
    @extend .c6;
  }
}

================================================================================
`;

