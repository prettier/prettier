exports[`snippet: libsass-closed-issues/issue_2975.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@mixin test($name: false) {
    $a: "";
    $b: "";
    @if $name {
        $a: "-#{$name}";    // works as expected
        $b: -$name;         // here occurs the bug
    } @else {
        $a: "";
        $b: "";
    }
    
    .test-a#{$a} {
        display: block;
    }
    .test-b#{$b} {
        display: block;
    }
}

@include test;
@include test(asdf);
@include test(foo1);
@include test(bar1);
// @include test("foo2");
// @include test("bar2");

=====================================output=====================================
@mixin test($name: false) {
  $a: "";
  $b: "";
  @if $name {
    $a: "-#{$name}"; // works as expected
    $b: -$name; // here occurs the bug
  } @else {
    $a: "";
    $b: "";
  }

  .test-a#{$a} {
    display: block;
  }
  .test-b#{$b} {
    display: block;
  }
}

@include test;
@include test(asdf);
@include test(foo1);
@include test(bar1);
// @include test("foo2");
// @include test("bar2");

================================================================================
`;

exports[`snippet: libsass-closed-issues/issue_2980.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:map";
$config: (
        phone: (
                break-point-width:0px,
                break-point-name: xs
        ),
        tablet: (
                break-point-width:600px,
                break-point-name: sm
        ),
        laptop: (
                break-point-width:900px,
                break-point-name: md
        ),
        desktop: (
                break-point-width:1200px,
                break-point-name:lg
        ),
);

@each $key, $map in $config {
  $break-point-width: map.get($map, break-point-width);
  $break-point-name: map.get($map, break-point-name);
  $infix: if($break-point-width == 0px, null, -$break-point-name);
      .foo#{$infix} {
        content: '#{$break-point-name}';
      }
}

=====================================output=====================================
@use "sass:map";
$config: (
  phone: (
    break-point-width: 0px,
    break-point-name: xs,
  ),
  tablet: (
    break-point-width: 600px,
    break-point-name: sm,
  ),
  laptop: (
    break-point-width: 900px,
    break-point-name: md,
  ),
  desktop: (
    break-point-width: 1200px,
    break-point-name: lg,
  ),
);

@each $key, $map in $config {
  $break-point-width: map.get($map, break-point-width);
  $break-point-name: map.get($map, break-point-name);
  $infix: if($break-point-width == 0px, null, -$break-point-name);
  .foo#{$infix} {
    content: "#{$break-point-name}";
  }
}

================================================================================
`;

