exports[`snippet: non_conformant/mixin/environment_locality.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
// The "$var" variable should only be set locally, despite being in the same
// mixin each time.
@mixin with-local-variable($recurse) {
  $var: before;

  @if ($recurse) {
    @include with-local-variable($recurse: false);
  }

  var: $var;
  $var: after;
}

.environment-locality {
  @include with-local-variable($recurse: true);
}

=====================================output=====================================
// The "$var" variable should only be set locally, despite being in the same
// mixin each time.
@mixin with-local-variable($recurse) {
  $var: before;

  @if ($recurse) {
    @include with-local-variable($recurse: false);
  }

  var: $var;
  $var: after;
}

.environment-locality {
  @include with-local-variable($recurse: true);
}

================================================================================
`;

