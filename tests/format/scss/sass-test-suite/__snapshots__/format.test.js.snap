=====================================input======================================
@use "sass:string";
@function test($pos) {
  @return test-#{$pos};
}

.foo {
  content: test(string.slice('scale-0', 7));   // Nope
  content: test-#{string.slice('scale-0', 7)}; // Yep
}
=====================================output=====================================
@use "sass:string";
@function test($pos) {
  @return test-#{$pos};
}

.foo {
  content: test(string.slice("scale-0", 7)); // Nope
  content: test-#{string.slice("scale-0", 7)}; // Yep
}

================================================================================
`;

