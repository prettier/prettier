  c94: color.adjust(hsl(100, 0%, 50%), $saturation: 94%);
  c95: color.adjust(hsl(100, 0%, 50%), $saturation: 95%);
  c96: color.adjust(hsl(100, 0%, 50%), $saturation: 96%);
  c97: color.adjust(hsl(100, 0%, 50%), $saturation: 97%);
  c98: color.adjust(hsl(100, 0%, 50%), $saturation: 98%);
  c99: color.adjust(hsl(100, 0%, 50%), $saturation: 99%);
  c100: color.adjust(hsl(100, 0%, 50%), $saturation: 100%);
}

================================================================================
`;

