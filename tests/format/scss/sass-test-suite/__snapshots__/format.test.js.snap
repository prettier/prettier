exports[`snippet: core_functions/string/unquote.hrx/escaped_backslash/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:string";
$result: string.unquote("\\\\0 ");
a {
  result: $result;
  length: string.length($result);
  same-as-argument: $result == "\\\\0 ";
  same-as-literal: $result == \\0 ;
}

=====================================output=====================================
@use "sass:string";
$result: string.unquote("\\\\0 ");
a {
