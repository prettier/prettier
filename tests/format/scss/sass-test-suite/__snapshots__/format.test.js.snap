exports[`snippet: non_conformant/scss/if-in-mixin.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
$x: true;

@mixin foobar() {
  @if $x {
    $x: false !global;
    content: foo;
  }
  @else {
    $x: true !global;
    content: bar;
  }
}

div {
  @include foobar();
  @include foobar();
  @include foobar();
  $x: true !global;
  @include foobar();
}

=====================================output=====================================
$x: true;

@mixin foobar() {
  @if $x {
    $x: false !global;
    content: foo;
  } @else {
    $x: true !global;
    content: bar;
  }
}

div {
  @include foobar();
  @include foobar();
  @include foobar();
  $x: true !global;
  @include foobar();
}

================================================================================
`;

