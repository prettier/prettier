exports[`snippet: libsass/selectors/mixin-argument.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:list";
@use "sass:meta";
@mixin selector-info($selector) {
  type: meta.type-of($selector);
  length: list.length($selector);
  content: $selector;
  @for $i from 1 through list.length($selector) {
    index: $i;
    length: list.length(list.nth($selector, $i));
    type: meta.type-of(list.nth($selector, $i));
    content: list.nth($selector, $i);
  }
}

.foo {
  @include selector-info(&);
}

.bar a {
  @include selector-info(&);
}

.bar,
.baz {
  @include selector-info(&);
}

.qux {
  &.waldo {
    .where & {
      .final {
        @include selector-info(&);
      }
    }
  }
}
=====================================output=====================================
@use "sass:list";
@use "sass:meta";
@mixin selector-info($selector) {
  type: meta.type-of($selector);
  length: list.length($selector);
  content: $selector;
  @for $i from 1 through list.length($selector) {
    index: $i;
    length: list.length(list.nth($selector, $i));
    type: meta.type-of(list.nth($selector, $i));
    content: list.nth($selector, $i);
  }
}

.foo {
  @include selector-info(&);
}

.bar a {
  @include selector-info(&);
}

.bar,
.baz {
  @include selector-info(&);
}

.qux {
  &.waldo {
    .where & {
      .final {
        @include selector-info(&);
      }
    }
  }
}

================================================================================
`;

exports[`snippet: libsass/selectors/simple.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
div {
  span, p, span {
    color: red;
  }
  a.foo.bar.foo {
    color: green;
  }
  &:nth(-3) {
    color: blue;
  }
}

@-webkit-keyframes {
  from {
    left: 0px;
  }
  to {
    left: 200px;
  }
}

div {
  @whatever {
    blah: blah;
    stuff {
      blah: bloh;
    }
  }
}


a, b {
  color: red;
  c, d {
    height: 10px;
    e, f {
      width: 12px;
    }
  }
}

=====================================output=====================================
div {
  span,
  p,
  span {
    color: red;
  }
  a.foo.bar.foo {
    color: green;
  }
  &:nth(-3) {
    color: blue;
  }
}

@-webkit-keyframes {
  from {
    left: 0px;
  }
  to {
    left: 200px;
  }
}

div {
  @whatever {
    blah: blah;
    stuff {
      blah: bloh;
    }
  }
}

a,
b {
  color: red;
  c,
  d {
    height: 10px;
    e,
    f {
      width: 12px;
    }
  }
}

================================================================================
`;

