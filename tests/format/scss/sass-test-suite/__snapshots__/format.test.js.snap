exports[`snippet: directives/use/css/import.hrx/nested_import_into_use/_imported.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:meta";
@use "used";

in-imported {parent: meta.inspect(&)}

