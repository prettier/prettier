exports[`snippet: libsass-closed-issues/issue_1133/normal.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:meta";
@function foo($map) {
    @return $map;
}

a {
    $map: foo((this: is, my: map));
    @each $k, $v in $map {
        #{$k}: $v;
    }
}

b {
    $map: meta.call("foo", (this: is, my: map));
    @each $k, $v in $map {
        #{$k}: $v;
    }
}

=====================================output=====================================
@use "sass:meta";
@function foo($map) {
  @return $map;
}

a {
  $map: foo(
    (
      this: is,
      my: map,
    )
  );
  @each $k, $v in $map {
    #{$k}: $v;
  }
}

b {
  $map: meta.call(
    "foo",
    (
      this: is,
      my: map,
    )
  );
  @each $k, $v in $map {
    #{$k}: $v;
  }
}

================================================================================
`;

