exports[`snippet: libsass-closed-issues/issue_555.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:map";

@function hello($name) {
    @return $name;
}

$foo: (
  bar() : baz,
  bar("foo") : blah,
  hello("bob") : bam,
);

a {
  foo: map.get($foo, "bar()");
  foo: map.get($foo, "bar(\\"foo\\")");
  foo: map.get($foo, 'bar("foo")');
  foo: map.get($foo, "bob");
}

=====================================output=====================================
@use "sass:map";

@function hello($name) {
  @return $name;
}

$foo: (
  bar(): baz,
  bar("foo"): blah,
  hello("bob"): bam,
);

a {
  foo: map.get($foo, "bar()");
  foo: map.get($foo, 'bar("foo")');
  foo: map.get($foo, 'bar("foo")');
  foo: map.get($foo, "bob");
}

================================================================================
`;

