exports[`snippet: directives/extend/pseudo.hrx/into_pseudo/extends_after/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
// Regression test for sass/dart-sass#1297, where the root cause was that
// extending an existing extension accidentally ignored simple selectors in
// selector pseudos
:is(midstream) {@extend upstream}

downstream {@extend midstream}

upstream {a: b}

=====================================output=====================================
// Regression test for sass/dart-sass#1297, where the root cause was that
// extending an existing extension accidentally ignored simple selectors in
// selector pseudos
:is(midstream) {
  @extend upstream;
}

downstream {
  @extend midstream;
}

upstream {
  a: b;
}

================================================================================
`;

