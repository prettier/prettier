exports[`snippet: libsass-closed-issues/issue_1415/mixin.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@mixin prepend-foo {
  $parent: &;

  @if $parent {
    .foo & {
      @content;
    }
  } @else {
    .foo {
      @content;
    }
  }
}

@include prepend-foo {
  bar {
    color: red;
  }
}

bar {
  @include prepend-foo {
    baz {
      color: red;
    }
  }
}

=====================================output=====================================
@mixin prepend-foo {
  $parent: &;

  @if $parent {
    .foo & {
      @content;
    }
  } @else {
    .foo {
      @content;
    }
  }
}

@include prepend-foo {
  bar {
    color: red;
  }
}

bar {
  @include prepend-foo {
    baz {
      color: red;
    }
  }
}

================================================================================
`;

