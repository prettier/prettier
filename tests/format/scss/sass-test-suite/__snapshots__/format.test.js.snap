                                                      printWidth: 80 (default) |
=====================================input======================================
outer {@import "imported"}

=====================================output=====================================
outer {
  @import "imported";
}

================================================================================
`;

exports[`snippet: directives/use/css/import.hrx/use_and_import_same/_other.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
// Every import always evaluates the file being imported, so this should be
// printed twice.
@debug "evaluating other";

a {b: c}

=====================================output=====================================
// Every import always evaluates the file being imported, so this should be
// printed twice.
@debug "evaluating other";

a {
  b: c;
}

================================================================================
`;

exports[`snippet: directives/use/css/import.hrx/use_and_import_same/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "other";

// @import always duplicates CSS, even when that CSS has been @used. In other
// words, @import's duplication takes precedence over @use's load-once policy.
@import "other";

=====================================output=====================================
@use "other";

// @import always duplicates CSS, even when that CSS has been @used. In other
// words, @import's duplication takes precedence over @use's load-once policy.
@import "other";

================================================================================
`;

