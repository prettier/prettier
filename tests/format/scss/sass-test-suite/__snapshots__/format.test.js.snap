exports[`snippet: non_conformant/mixin/content/arguments/none.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
// \`@content()\` and \`@content\` should behave identically, as should
// \`@include foo\` and \`@include foo using ()\`.

no-parens {
  @mixin mixin {
    @content;
  }

  empty-using {
    @include mixin using () {
      x: y;
    }
  }

  defaults {
    @include mixin using ($arg1: value1, $arg2: value2) {
      arg1: $arg1;
      arg2: $arg2;
    }
  }
}

parens {
  @mixin mixin {
    @content();
  }

  no-using {
    @include mixin {
      x: y;
    }
  }

  empty-using {
    @include mixin using () {
      x: y;
    }
  }

  defaults {
    @include mixin using ($arg1: value1, $arg2: value2) {
      arg1: $arg1;
      arg2: $arg2;
    }
  }
}

=====================================output=====================================
// \`@content()\` and \`@content\` should behave identically, as should
// \`@include foo\` and \`@include foo using ()\`.

no-parens {
  @mixin mixin {
    @content;
  }

  empty-using {
    @include mixin using () {
      x: y;
    }
  }

  defaults {
    @include mixin using ($arg1: value1, $arg2: value2) {
      arg1: $arg1;
      arg2: $arg2;
    }
  }
}

parens {
  @mixin mixin {
    @content();
  }

  no-using {
    @include mixin {
      x: y;
    }
  }

  empty-using {
    @include mixin using () {
      x: y;
    }
  }

  defaults {
    @include mixin using ($arg1: value1, $arg2: value2) {
      arg1: $arg1;
      arg2: $arg2;
    }
  }
}

================================================================================
`;

exports[`snippet: non_conformant/mixin/content/arguments/passing.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
// Arguments can be passed to content blocks in all the same ways as they're
// passed to any other argument list.

by-position {
  @mixin mixin {
    @content(value1, value2);
  }

  @include mixin using ($arg1, $arg2) {
    arg1: $arg1;
    arg2: $arg2;
  }
}

by-name {
  @mixin mixin {
    @content($arg1: value1, $arg2: value2);
  }

  @include mixin using ($arg1, $arg2) {
    arg1: $arg1;
    arg2: $arg2;
  }
}

list-splat {
  @mixin mixin {
    @content((value1 value2)...);
  }

  @include mixin using ($arg1, $arg2) {
    arg1: $arg1;
    arg2: $arg2;
  }
}

map-splat {
  @mixin mixin {
    @content((arg1: value1, arg2: value2)...);
  }

  @include mixin using ($arg1, $arg2) {
    arg1: $arg1;
    arg2: $arg2;
  }
}

mixed-splat {
  @mixin mixin {
    @content((value1,)..., (arg2: value2)...);
  }

  @include mixin using ($arg1, $arg2) {
    arg1: $arg1;
    arg2: $arg2;
  }
}

=====================================output=====================================
// Arguments can be passed to content blocks in all the same ways as they're
// passed to any other argument list.

by-position {
  @mixin mixin {
    @content (value1, value2);
  }

  @include mixin using ($arg1, $arg2) {
    arg1: $arg1;
    arg2: $arg2;
  }
}

by-name {
  @mixin mixin {
    @content ($arg1: value1, $arg2: value2);
  }

  @include mixin using ($arg1, $arg2) {
    arg1: $arg1;
    arg2: $arg2;
  }
}

list-splat {
  @mixin mixin {
    @content ((value1 value2)...);
  }

  @include mixin using ($arg1, $arg2) {
    arg1: $arg1;
    arg2: $arg2;
  }
}

map-splat {
  @mixin mixin {
    @content ((arg1: value1, arg2: value2)...);
  }

  @include mixin using ($arg1, $arg2) {
    arg1: $arg1;
    arg2: $arg2;
  }
}

mixed-splat {
  @mixin mixin {
    @content ((value1,)..., (arg2: value2)...);
  }

  @include mixin using ($arg1, $arg2) {
    arg1: $arg1;
    arg2: $arg2;
  }
}

================================================================================
`;

exports[`snippet: non_conformant/mixin/content/arguments/receiving.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:meta";
// Content blocks' argument lists can define arguments in in all the same ways
// as they're defined in any other argument list.

with-defaults {
  nothing-passed {
    @mixin mixin {
      @content;
    }

    @include mixin using ($arg1: value1, $arg2: value2) {
      arg1: $arg1;
      arg2: $arg2;
    }
  }

  partial-override {
    @mixin mixin {
      @content($arg2: other2);
    }

    @include mixin using ($arg1: value1, $arg2: value2) {
      arg1: $arg1;
      arg2: $arg2;
    }
  }

  total-override {
    @mixin mixin {
      @content(other1, other2);
    }

    @include mixin using ($arg1: value1, $arg2: value2) {
      arg1: $arg1;
      arg2: $arg2;
    }
  }
}

with-splat {
  nothing-passed {
    @mixin mixin {
      @content;
    }

    @include mixin using ($args...) {
      positional: meta.inspect($args);
      keywords: meta.inspect(meta.keywords($args));
    }
  }

  positional-passed {
    @mixin mixin {
      @content(value1, value2, value3);
    }

    @include mixin using ($args...) {
      positional: meta.inspect($args);
      keywords: meta.inspect(meta.keywords($args));
    }
  }

  named-passed {
    @mixin mixin {
      @content($arg1: value1, $arg2: value2);
    }

    @include mixin using ($args...) {
      positional: meta.inspect($args);
      keywords: meta.inspect(meta.keywords($args));
    }
  }

  both-passed {
    @mixin mixin {
      @content(value1, $arg2: value2);
    }

    @include mixin using ($args...) {
      positional: meta.inspect($args);
      keywords: meta.inspect(meta.keywords($args));
    }
  }
}

=====================================output=====================================
@use "sass:meta";
// Content blocks' argument lists can define arguments in in all the same ways
// as they're defined in any other argument list.

with-defaults {
  nothing-passed {
    @mixin mixin {
      @content;
    }

    @include mixin using ($arg1: value1, $arg2: value2) {
      arg1: $arg1;
      arg2: $arg2;
    }
  }

  partial-override {
    @mixin mixin {
      @content ($arg2: other2);
    }

    @include mixin using ($arg1: value1, $arg2: value2) {
      arg1: $arg1;
      arg2: $arg2;
    }
  }

  total-override {
    @mixin mixin {
      @content (other1, other2);
    }

    @include mixin using ($arg1: value1, $arg2: value2) {
      arg1: $arg1;
      arg2: $arg2;
    }
  }
}

with-splat {
  nothing-passed {
    @mixin mixin {
      @content;
    }

    @include mixin using ($args...) {
      positional: meta.inspect($args);
      keywords: meta.inspect(meta.keywords($args));
    }
  }

  positional-passed {
    @mixin mixin {
      @content (value1, value2, value3);
    }

    @include mixin using ($args...) {
      positional: meta.inspect($args);
      keywords: meta.inspect(meta.keywords($args));
    }
  }

  named-passed {
    @mixin mixin {
      @content ($arg1: value1, $arg2: value2);
    }

    @include mixin using ($args...) {
      positional: meta.inspect($args);
      keywords: meta.inspect(meta.keywords($args));
    }
  }

  both-passed {
    @mixin mixin {
      @content (value1, $arg2: value2);
    }

    @include mixin using ($args...) {
      positional: meta.inspect($args);
      keywords: meta.inspect(meta.keywords($args));
    }
  }
}

================================================================================
`;

exports[`snippet: non_conformant/mixin/content/arguments/scope.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
// Arguments passed to @content blocks are lexically-scoped within those blocks.

$var: top-level;

@mixin mixin($var) {
  mixin-var-before: $var;
  @content(content-argument);
  mixin-var-after: $var;
}

@mixin inner {
  var-in-inner: $var;
}

scope {
  var-before: $var;
  @include mixin(mixin-argument) using ($var) {
    content-var-before: $var;
    @include inner;
    content-var-after: $var;
  }
  var-after: $var;
}

=====================================output=====================================
// Arguments passed to @content blocks are lexically-scoped within those blocks.

$var: top-level;

@mixin mixin($var) {
  mixin-var-before: $var;
  @content (content-argument);
  mixin-var-after: $var;
}

@mixin inner {
  var-in-inner: $var;
}

scope {
  var-before: $var;
  @include mixin(mixin-argument) using ($var) {
    content-var-before: $var;
    @include inner;
    content-var-after: $var;
  }
  var-after: $var;
}

================================================================================
`;

