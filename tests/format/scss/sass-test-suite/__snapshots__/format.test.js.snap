exports[`snippet: non_conformant/scss/cons-up.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:string";
@use "sass:list";

$inputs-list: 'input[type="email"]',
              'input[type="number"]',
              'input[type="password"]',
              'input[type="search"]',
              'input[type="tel"]',
              'input[type="text"]',
              'input[type="url"]',

              // Webkit & Gecko may change the display of these in the future
              'input[type="color"]',
              'input[type="date"]',
              'input[type="datetime"]',
              'input[type="datetime-local"]',
              'input[type="month"]',
              'input[type="time"]',
              'input[type="week"]';

$unquoted-inputs-list: ();

@each $input-type in $inputs-list {
  $unquoted-inputs-list: list.append($unquoted-inputs-list, string.unquote($input-type), comma);
}

div {
  content: $unquoted-inputs-list;
  content: list.append((), hello);
  content: list.length(());
}
=====================================output=====================================
@use "sass:string";
@use "sass:list";

$inputs-list:
  'input[type="email"]',
  'input[type="number"]',
  'input[type="password"]',
  'input[type="search"]',
  'input[type="tel"]',
  'input[type="text"]',
  'input[type="url"]',
  // Webkit & Gecko may change the display of these in the future
  'input[type="color"]',
  'input[type="date"]',
  'input[type="datetime"]',
  'input[type="datetime-local"]',
  'input[type="month"]',
  'input[type="time"]',
  'input[type="week"]';

$unquoted-inputs-list: ();

@each $input-type in $inputs-list {
  $unquoted-inputs-list: list.append(
    $unquoted-inputs-list,
    string.unquote($input-type),
    comma
  );
}

div {
  content: $unquoted-inputs-list;
  content: list.append((), hello);
  content: list.length(());
}

================================================================================
`;

exports[`snippet: non_conformant/scss/css_basic_scss.hrx/input.scss format 1`] = `
====================================options=====================================
