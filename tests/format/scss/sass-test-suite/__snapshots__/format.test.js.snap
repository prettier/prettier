exports[`snippet: libsass-closed-issues/issue_1604.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:list";
@use "sass:meta";

@function test($args...) {
  $all: ();

  @each $arg in $args {
    $all: list.append($all, $arg);
  }

  @return meta.inspect($all);
}

test {
  args-1: test(1 2 3);
  args-2: test(1 2, 3 4);
  args-3: test(1, 2, 3);
}

=====================================output=====================================
@use "sass:list";
@use "sass:meta";

@function test($args...) {
  $all: ();

  @each $arg in $args {
    $all: list.append($all, $arg);
  }

  @return meta.inspect($all);
}

test {
  args-1: test(1 2 3);
  args-2: test(1 2, 3 4);
  args-3: test(1, 2, 3);
}

================================================================================
`;

exports[`snippet: libsass-closed-issues/issue_1610.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@function foo() {
  @return "bar";
}

@function bar() {
    @return "foo" + "," + bar;
}

a {
  b: foo(), "bar";
  b: foo(), "bar"
}

b {
  b: #{foo(), "bar"};
  b: #{foo(), "bar"}
}

c {
  b: "foo", bar;
}

d {
  b: #{"foo", bar};
  b: #{"foo", bar}
}

e {
  b: #{bar()};
  b: #{bar()}
}

f {
  b: "foo" + "," + bar;
  b: "foo" + "," + bar
}

=====================================output=====================================
@function foo() {
  @return "bar";
}

@function bar() {
  @return "foo" + "," + bar;
}

a {
  b: foo(), "bar";
  b: foo(), "bar";
}

b {
  b:
    #{foo(),
    "bar"};
  b:
    #{foo(),
    "bar"};
}

c {
  b: "foo", bar;
}

d {
  b:
    #{"foo",
    bar};
  b:
    #{"foo",
    bar};
}

e {
  b: #{bar()};
  b: #{bar()};
}

f {
  b: "foo" + "," + bar;
  b: "foo" + "," + bar;
}

================================================================================
`;

