exports[`snippet: libsass-closed-issues/issue_672.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:meta";
@mixin test($arglist...) {
    $map: meta.keywords($arglist);
    answer: if($map, "Yep", "Nope");
}

with-keyword-args{
    @include test($arg1: one, $arg2: two, $arg3: three);
}
with-no-args {
    @include test();
}
without-keyword-args {
    @include test(not-a-keyword-arg-1 , not-a-keyword-arg-2);
}

=====================================output=====================================
@use "sass:meta";
@mixin test($arglist...) {
  $map: meta.keywords($arglist);
  answer: if($map, "Yep", "Nope");
}

with-keyword-args {
  @include test($arg1: one, $arg2: two, $arg3: three);
}
with-no-args {
  @include test();
}
without-keyword-args {
  @include test(not-a-keyword-arg-1, not-a-keyword-arg-2);
}

================================================================================
`;

