exports[`snippet: libsass-closed-issues/issue_1271.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:string";
$character-code: f102;

test {

  /* Expected: "\\f102" */

  /* Sass 3.4 */
  content: string.unquote("\\"\\\\#{$character-code}\\"");

  /* Sass 3.3 */
  content: string.slice("\\x", 1, 1) + $character-code;

}
=====================================output=====================================
@use "sass:string";
$character-code: f102;

test {
  /* Expected: "\\f102" */

  /* Sass 3.4 */
  content: string.unquote('"\\\\#{$character-code}"');

  /* Sass 3.3 */
  content: string.slice("\\x", 1, 1) + $character-code;
}

================================================================================
`;

