  function: local();
}

================================================================================
`;

exports[`snippet: directives/import/nested.hrx/scope/mixin/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
.parent {
  // This should be visible to the imported stylesheet. There's not really a
  // good reason for this, but it's the historical behavior so whatever.
  @mixin local {
    x {y: z}
  }

  @import 'other';
}

=====================================output=====================================
.parent {
  // This should be visible to the imported stylesheet. There's not really a
  // good reason for this, but it's the historical behavior so whatever.
  @mixin local {
    x {
      y: z;
    }
  }

  @import "other";
}

================================================================================
`;

