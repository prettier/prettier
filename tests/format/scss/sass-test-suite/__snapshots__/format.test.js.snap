exports[`snippet: libsass-closed-issues/issue_1583.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:list";
@use "sass:meta";
@use "sass:string";

$ls: ((foo,));

foo {
  baz: list.length($ls);
  baz: meta.type-of($ls);
  baz: meta.inspect($ls);
}

bar {
  baz: list.length(&);
  baz: meta.type-of(&);
  baz: meta.inspect(&);
}

foo {
  string: meta.inspect(&);
  str-length: string.length(meta.inspect(&));
  list-length: list.length(&);
}

foo, bar {
  string: meta.inspect(&);
  str-length: string.length(meta.inspect(&));
  list-length: list.length(&);
}

=====================================output=====================================
@use "sass:list";
@use "sass:meta";
@use "sass:string";

$ls: ((foo));

foo {
  baz: list.length($ls);
  baz: meta.type-of($ls);
  baz: meta.inspect($ls);
}

bar {
  baz: list.length(&);
  baz: meta.type-of(&);
  baz: meta.inspect(&);
}

foo {
  string: meta.inspect(&);
  str-length: string.length(meta.inspect(&));
  list-length: list.length(&);
}

foo,
bar {
  string: meta.inspect(&);
  str-length: string.length(meta.inspect(&));
  list-length: list.length(&);
}

================================================================================
`;

exports[`snippet: libsass-closed-issues/issue_1584.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@mixin foo($out: false) {
  @if $out {
    @at-root { @content; }
  }
}

@mixin bar() {
  @at-root { @content; }
}

@mixin baz($string) {
  @at-root .#{$string} { @content; }
}

.test {
  @include foo(true) {
    .nest1 {
      color: red;
    }
  }
  @include bar() {
    .nest2 {
      color: green;
    }
  }
  @include baz('nest3') {
    color: blue;
  }
  @at-root {
    .nest4 {
      color: yellow;
    }
  }
}

=====================================output=====================================
@mixin foo($out: false) {
  @if $out {
    @at-root {
      @content;
    }
  }
}

@mixin bar() {
  @at-root {
    @content;
  }
}

@mixin baz($string) {
  @at-root .#{$string} {
    @content;
  }
}

.test {
  @include foo(true) {
    .nest1 {
      color: red;
    }
  }
  @include bar() {
    .nest2 {
      color: green;
    }
  }
  @include baz("nest3") {
    color: blue;
  }
  @at-root {
    .nest4 {
      color: yellow;
    }
  }
}

================================================================================
`;

