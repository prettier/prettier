exports[`snippet: core_functions/meta/inspect/color.hrx/generated/_utils.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:color";
/// Returns a copy of \`$color\` that doesn't have color-literal metadata
/// associated with it.
@function generated-color($color) {
  // This doesn't change the value of \`$color\` at all, but it does construct a
  // new object.
  @return color.scale($color, $blue: 0%);
}

=====================================output=====================================
@use "sass:color";
/// Returns a copy of \`$color\` that doesn't have color-literal metadata
/// associated with it.
@function generated-color($color) {
  // This doesn't change the value of \`$color\` at all, but it does construct a
  // new object.
  @return color.scale($color, $blue: 0%);
}

================================================================================
`;

