exports[`snippet: non_conformant/scss-tests/187_test_multiline_var.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
foo {
  $var1: 1 +
    2;
  $var2: true and
    false;
  $var3: a b
    c;
  a: $var1;
  b: $var2;
  c: $var3; }

=====================================output=====================================
foo {
  $var1: 1 + 2;
  $var2: true and false;
  $var3: a b c;
  a: $var1;
  b: $var2;
  c: $var3;
}

================================================================================
`;

exports[`snippet: non_conformant/scss-tests/188_test_mixin_content.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
$color: blue;
@mixin context($class, $color: red) {
  .#{$class} {
    background-color: $color;
    @content;
    border-color: $color;
  }
}
@include context(parent) {
  @include context(child, $color: yellow) {
    color: $color;
  }
}

=====================================output=====================================
$color: blue;
@mixin context($class, $color: red) {
  .#{$class} {
    background-color: $color;
    @content;
    border-color: $color;
  }
}
@include context(parent) {
  @include context(child, $color: yellow) {
    color: $color;
  }
}

================================================================================
`;

exports[`snippet: non_conformant/scss-tests/189_test_empty_content.hrx/input.scss format 1`] = `
