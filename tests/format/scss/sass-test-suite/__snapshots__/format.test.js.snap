exports[`snippet: libsass-closed-issues/issue_2480.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@mixin main(
  $param1: param1,
  $param2: param2,
  $param3: param3
) {
  param1-value: $param1;
  param2-value: $param2;
  param3-value: $param3;
}

@mixin router($args...) {
  @if (true) { @include main($args...) }
  @else { @include main2($args...) }
}

@mixin helper($args...) {
  @include router($param2: param__2, $args...)
}

.ordinal-arguments {
  @include helper(param___1);
}

.named-arguments {
  @include helper($param1: param___1);
}
=====================================output=====================================
@mixin main($param1: param1, $param2: param2, $param3: param3) {
  param1-value: $param1;
  param2-value: $param2;
  param3-value: $param3;
}

@mixin router($args...) {
  @if (true) {
    @include main($args...);
  } @else {
    @include main2($args...);
  }
}

@mixin helper($args...) {
  @include router($param2: param__2, $args...);
}

.ordinal-arguments {
  @include helper(param___1);
}

.named-arguments {
  @include helper($param1: param___1);
}

