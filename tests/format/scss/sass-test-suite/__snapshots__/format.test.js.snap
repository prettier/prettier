@use "sass:meta";
@use "sass:string";
$result: string.split("", "/");
a {
  value: meta.inspect($result);
  separator: list.separator($result); 
}

=====================================output=====================================
@use "sass:list";
@use "sass:meta";
@use "sass:string";
$result: string.split("", "/");
a {
  value: meta.inspect($result);
  separator: list.separator($result);
}

================================================================================
`;

