exports[`snippet: non_conformant/scss-tests/174_test_import_comments_in_imports.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@import "foo.css", // this is a comment
        "bar.css", /* this is another comment */
        "baz.css"; // this is a third comment

=====================================output=====================================
@import "foo.css",
  // this is a comment
  "bar.css",
  /* this is another comment */ "baz.css"; // this is a third comment

================================================================================
`;

exports[`snippet: non_conformant/scss-tests/176_test_newline_selector_rendered_multiple_times.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@for $i from 1 through 2 {
  form {
    input,
    select {
      color: white;
    }
  }
}

=====================================output=====================================
@for $i from 1 through 2 {
  form {
    input,
    select {
      color: white;
    }
  }
}

================================================================================
`;

