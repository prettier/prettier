@function get-member() {
  @return $member;
}

================================================================================
`;

exports[`snippet: directives/use/member/global.hrx/variable_assignment/nested/local/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "other" as *;

a {
  // A nested variable assignment that doesn't have a namespace and isn't
  // !global creates a new local variable rather than assigning to a variable
  // imported from a module.
  $member: new value;

  b: get-member();
}

=====================================output=====================================
@use "other" as *;

a {
  // A nested variable assignment that doesn't have a namespace and isn't
  // !global creates a new local variable rather than assigning to a variable
  // imported from a module.
  $member: new value;

  b: get-member();
}

================================================================================
`;

