exports[`snippet: core_functions/string/split.hrx/double_width_character/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:string";
// Sass treats strings as sequences of Unicode codepoint; it doesn't care if a
// character is represented as two UTF-16 code units.
a {b: string.split("👭a", "")}

=====================================output=====================================
@use "sass:string";
// Sass treats strings as sequences of Unicode codepoint; it doesn't care if a
// character is represented as two UTF-16 code units.
a {
  b: string.split("👭a", "");
}

================================================================================
`;

