exports[`snippet: libsass-closed-issues/issue_2330.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:list";
@use "sass:map";
@use "sass:meta";

@function test () {
  $m: ();
  $abc: (a b c d e f g h i j k);

  @for $index from 1 through list.length($abc) {;
    $m: map.merge($m, (list.nth($abc, $index):$index) );
  }

  @return $m;
}

test {
  content: meta.inspect(test());
}
=====================================output=====================================
@use "sass:list";
@use "sass:map";
@use "sass:meta";

@function test() {
  $m: ();
  $abc: (a b c d e f g h i j k);

  @for $index from 1 through list.length($abc) {
    $m: map.merge(
      $m,
      (
        list.nth($abc, $index): $index,
      )
    );
  }

  @return $m;
}

test {
  content: meta.inspect(test());
}

================================================================================
`;

