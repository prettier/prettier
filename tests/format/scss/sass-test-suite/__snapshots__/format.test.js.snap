exports[`snippet: libsass/at-root/with_without.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
// Unquoted

@media (min-width: 1337px) {
  .foo {
    content: baz;
  }

  @at-root (without: media) {
    .foo {
      content: bar;
    }
  }
}

@media (min-width: 1337px) {
  .foo {
    content: baz;
  }

  @at-root (without: all) {
    .foo {
      content: bar;
    }
  }
}

@supports (color: red) {
  .foo {
    content: baz;
  }

  @at-root (without: supports) {
    .foo {
      content: bar;
    }
  }
}

@supports (color: red) {
  .foo {
    content: baz;
  }

  @at-root (without: all) {
    .foo {
      content: bar;
    }
  }
}

@media (min-width: 1337px) {
  @supports (color: red) {
    @at-root {
      .foo {
        content: bar;
      }
    }
  }
}

@media (min-width: 1337px) {
  @supports (color: red) {
    @at-root (without: all) {
      .foo {
        content: bar;
      }
    }
  }
}

@media (min-width: 1337px) {
  @supports (color: red) {
    @at-root (without: media supports) {
      .foo {
        content: bar;
      }
    }
  }
}

@media (min-width: 1337px) {
  @supports (color: red) {
    @at-root (without: media) {
      .foo {
        content: bar;
      }
    }
  }
}

@media (min-width: 1337px) {
  @supports (color: red) {
    @at-root (without: supports) {
