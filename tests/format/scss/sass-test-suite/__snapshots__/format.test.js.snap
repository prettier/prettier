exports[`snippet: core_functions/selector/extend/simple/pseudo/selector/idempotent/nth_child.hrx/different_arg_in_extender/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:selector";
// This should produce \`:nth-child(2n + 1 of .c, :nth-child(2n + 1 of .d, .e))\`.
// See sass/sass#2828.
a {
  b: selector.extend(
      ":nth-child(2n + 1 of .c)",
      ".c",
      ":nth-child(2n + 2 of .d, .e)");
}

=====================================output=====================================
@use "sass:selector";
// This should produce \`:nth-child(2n + 1 of .c, :nth-child(2n + 1 of .d, .e))\`.
// See sass/sass#2828.
a {
  b: selector.extend(
    ":nth-child(2n + 1 of .c)",
