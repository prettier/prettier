exports[`snippet: libsass-closed-issues/issue_1757/for.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:list";
.test .nest {
  length: list.length(&);
  @for $i from 1 through list.length(&) {
    $list: list.nth(&, $i);
    list: $list;
    length: list.length($list);
  }
}

.test, .other {
  length: list.length(&);
  @for $i from 1 through list.length(&) {
    $list: list.nth(&, $i);
    list: $list;
    length: list.length($list);
  }
}

=====================================output=====================================
@use "sass:list";
.test .nest {
  length: list.length(&);
  @for $i from 1 through list.length(&) {
    $list: list.nth(&, $i);
    list: $list;
    length: list.length($list);
  }
}

.test,
.other {
  length: list.length(&);
  @for $i from 1 through list.length(&) {
    $list: list.nth(&, $i);
    list: $list;
    length: list.length($list);
  }
}

================================================================================
`;

