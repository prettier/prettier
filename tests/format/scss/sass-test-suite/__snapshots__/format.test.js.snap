exports[`snippet: libsass-closed-issues/issue_1739/interpolate/both.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
div {
  baz: #{1/2}/#{1/2};
  baz: #{1/  2}/  #{1/  2};
  baz: #{1  /2}  /#{1  /2};
  baz: #{1  /  2}  /  #{1  /  2};
}

add {
  baz: #{1+2}+#{1+2};
  baz: #{1+  2}+  #{1+  2};
  baz: #{1  +2}  +#{1  +2};
  baz: #{1  +  2}  +  #{1  +  2};
}

sub {
  baz: #{1-2}-#{1-2};
  baz: #{1-  2}-  #{1-  2};
  baz: #{1  -2}  -#{1  -2};
  baz: #{1  -  2}  -  #{1  -  2};
}

mul {
  baz: #{1*2}*#{1*2};
  baz: #{1*  2}*  #{1*  2};
  baz: #{1  *2}  *#{1  *2};
  baz: #{1  *  2}  *  #{1  *  2};
}

mod {
  baz: #{1%2}%#{1%2};
  baz: #{1%  2}%  #{1%  2};
  baz: #{1  %2}  %#{1  %2};
  baz: #{1  %  2}  %  #{1  %  2};
}
=====================================output=====================================
div {
  baz: #{1/2}/#{1/2};
  baz: #{1/ 2}/ #{1/ 2};
  baz: #{1 /2} /#{1 /2};
  baz: #{1 / 2} / #{1 / 2};
}

add {
  baz: #{1+2}+#{1+2};
  baz: #{1+ 2}+ #{1+ 2};
  baz: #{1 +2} +#{1 +2};
  baz: #{1 + 2} + #{1 + 2};
}

sub {
  baz: #{1-2}-#{1-2};
  baz: #{1- 2}- #{1- 2};
  baz: #{1 -2} -#{1 -2};
  baz: #{1 - 2} - #{1 - 2};
}

mul {
  baz: #{1 * 2}*#{1 * 2};
  baz: #{1 * 2}* #{1 * 2};
  baz: #{1 * 2} *#{1 * 2};
  baz: #{1 * 2} * #{1 * 2};
}

mod {
  baz: #{1%2}%#{1%2};
  baz: #{1% 2}% #{1% 2};
  baz: #{1 %2} %#{1 %2};
  baz: #{1 % 2} % #{1 % 2};
}

================================================================================
`;

