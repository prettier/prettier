exports[`snippet: core_functions/selector/unify/complex/lcs.hrx/three_versus_two/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:selector";
// The longest common subsequence is \`.c .d .e\`, which is longer than \`.f g\`, so
// \`.c .d .e\` gets unified while \`.f .g\` gets duplicated.
a {b: selector.unify(".c .d .e .f .g .s1", ".f .g .c .d .e .s2")}

=====================================output=====================================
@use "sass:selector";
// The longest common subsequence is \`.c .d .e\`, which is longer than \`.f g\`, so
// \`.c .d .e\` gets unified while \`.f .g\` gets duplicated.
a {
  b: selector.unify(".c .d .e .f .g .s1", ".f .g .c .d .e .s2");
}

================================================================================
`;

exports[`snippet: core_functions/selector/unify/complex/lcs.hrx/two_versus_one/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:selector";
// The longest common subsequence is \`.c .d\`, which is longer than \`.e\`, so \`.c
// .d\` gets unified while \`.e\` gets duplicated.
a {b: selector.unify(".c .d .e .s1", ".e .c .d .s2")}

=====================================output=====================================
@use "sass:selector";
// The longest common subsequence is \`.c .d\`, which is longer than \`.e\`, so \`.c
// .d\` gets unified while \`.e\` gets duplicated.
a {
  b: selector.unify(".c .d .e .s1", ".e .c .d .s2");
}

================================================================================
`;

exports[`snippet: core_functions/selector/unify/complex/overlap.hrx/class/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:selector";
// Because neither compound selector containing \`.c\` is a superselector of the
// other, they aren't unified.
a {b: selector.unify(".c.s1-1 .s1-2", ".c.s2-1 .s2-2")}

=====================================output=====================================
@use "sass:selector";
// Because neither compound selector containing \`.c\` is a superselector of the
// other, they aren't unified.
a {
  b: selector.unify(".c.s1-1 .s1-2", ".c.s2-1 .s2-2");
}

================================================================================
`;

exports[`snippet: core_functions/selector/unify/complex/overlap.hrx/id/forced_unification/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:selector";
// Even though neither selector containing \`#c\` is a superselector of the other,
// they're still unified because the selector can't meainingfully contain two
// instances of \`#c\`.
a {b: selector.unify("#c.s1-1 .s1-2", "#c.s2-1 .s2-2")}

=====================================output=====================================
@use "sass:selector";
// Even though neither selector containing \`#c\` is a superselector of the other,
// they're still unified because the selector can't meainingfully contain two
// instances of \`#c\`.
a {
  b: selector.unify("#c.s1-1 .s1-2", "#c.s2-1 .s2-2");
}

================================================================================
`;

exports[`snippet: core_functions/selector/unify/complex/overlap.hrx/id/no_unification/input.scss format 1`] = `
