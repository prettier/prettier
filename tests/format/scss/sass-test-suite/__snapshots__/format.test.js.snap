exports[`snippet: non_conformant/extend-tests/184_test_control_flow_if.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
.true  { color: green; }
.false { color: red;   }
.also-true {
@if true { @extend .true;  }
@else    { @extend .false; }
}
.also-false {
@if false { @extend .true;  }
@else     { @extend .false; }
}

=====================================output=====================================
.true {
  color: green;
}
.false {
  color: red;
}
.also-true {
  @if true {
    @extend .true;
  } @else {
    @extend .false;
  }
}
.also-false {
  @if false {
    @extend .true;
  } @else {
    @extend .false;
  }
}

================================================================================
`;

exports[`snippet: non_conformant/extend-tests/185_test_control_flow_for.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
.base-0  { color: green; }
.base-1  { display: block; }
.base-2  { border: 1px solid blue; }
.added {
@for $i from 0 to 3 {
  @extend .base-#{$i};
}
}

=====================================output=====================================
.base-0 {
  color: green;
}
.base-1 {
  display: block;
}
.base-2 {
  border: 1px solid blue;
}
.added {
  @for $i from 0 to 3 {
    @extend .base-#{$i};
  }
}

================================================================================
`;

exports[`snippet: non_conformant/extend-tests/186_test_control_flow_while.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
.base-0  { color: green; }
.base-1  { display: block; }
.base-2  { border: 1px solid blue; }
.added {
$i : 0;
@while $i < 3 {
  @extend .base-#{$i};
  $i : $i + 1;
}
}

=====================================output=====================================
.base-0 {
  color: green;
}
.base-1 {
  display: block;
}
.base-2 {
  border: 1px solid blue;
}
.added {
  $i: 0;
  @while $i < 3 {
    @extend .base-#{$i};
    $i: $i + 1;
  }
}

================================================================================
`;

