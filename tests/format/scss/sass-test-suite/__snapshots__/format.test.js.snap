exports[`snippet: libsass-closed-issues/issue_577.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:list";
@function map-each($map) {
  $values: ();

  @each $key, $value in $map {
    $values: list.append($values, $value);
  }

  @return $values;
}

$map: (foo: bar);

.test {
  -map-test: map-each($map);
}

=====================================output=====================================
@use "sass:list";
@function map-each($map) {
  $values: ();

  @each $key, $value in $map {
    $values: list.append($values, $value);
  }

  @return $values;
}

$map: (
  foo: bar,
);

.test {
  -map-test: map-each($map);
}

================================================================================
`;

