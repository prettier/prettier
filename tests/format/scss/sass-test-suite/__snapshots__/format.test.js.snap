exports[`snippet: directives/use/member/namespaced.hrx/default/variable_assignment/in_declaration/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "other";

a {
  b: {
    // Test assignments within a declaration specially, because declarations
    // disallow style rules and variable assignments need to be disambiguated
    // with those.
    other.$member: new value;

    c: other.get-member();
  }
}

=====================================output=====================================
@use "other";

a {
  b: {
    // Test assignments within a declaration specially, because declarations
    // disallow style rules and variable assignments need to be disambiguated
    // with those.
    other.$member: new value;

    c: other.get-member();
  }
}

================================================================================
`;

