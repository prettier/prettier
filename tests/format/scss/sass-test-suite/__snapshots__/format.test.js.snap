exports[`snippet: callable/arguments.hrx/function/_utils.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use 'sass:meta';

@function a($args...) {
  @return meta.inspect((
    positional: $args,
    named: meta.keywords($args),
  ));
}

=====================================output=====================================
@use "sass:meta";

@function a($args...) {
  @return meta.inspect(
    (
      positional: $args,
      named: meta.keywords($args),
    )
  );
}

================================================================================
`;

