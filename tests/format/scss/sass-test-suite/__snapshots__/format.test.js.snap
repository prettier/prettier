exports[`snippet: libsass-closed-issues/issue_1796.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:list";
.parent {
    .brother, .sister, .cousin {
        color: green;
        sel: &;

        $new-sel: ();
        @each $s in & {
            $last: list.nth($s, -1);
            $new-sel: list.append($new-sel, $s #{'+'} $last, comma);
            x: $new-sel;
        }
        @at-root #{$new-sel} {
            debug: foo;
        }
    }
}
=====================================output=====================================
@use "sass:list";
.parent {
  .brother,
  .sister,
  .cousin {
    color: green;
    sel: &;

    $new-sel: ();
    @each $s in & {
      $last: list.nth($s, -1);
      $new-sel: list.append($new-sel, $s #{"+"} $last, comma);
      x: $new-sel;
    }
    @at-root #{$new-sel} {
      debug: foo;
    }
  }
}

================================================================================
`;

