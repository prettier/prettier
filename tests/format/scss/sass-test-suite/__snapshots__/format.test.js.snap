exports[`snippet: core_functions/selector/extend/simple/pseudo/selector/idempotent/not.hrx/list_in_not/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:selector";
// If the original :not() already contains a selector list, we add new selectors
// to that list because there's no risk of breaking additional browsers.
a {b: selector.extend(":not(.c, .d)", ".c", ".e")}

=====================================output=====================================
@use "sass:selector";
// If the original :not() already contains a selector list, we add new selectors
// to that list because there's no risk of breaking additional browsers.
a {
  b: selector.extend(":not(.c, .d)", ".c", ".e");
}

================================================================================
`;

