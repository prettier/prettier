exports[`snippet: directives/for/for.hrx/to_scope/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
// Overriding the variable inside the loop will not impact the end of the loop.
$limit: 4;

@for $i from 1 through $limit {
  $limit: 2;
  a {
    limit: $limit;
    i: $i;
  }
}

=====================================output=====================================
// Overriding the variable inside the loop will not impact the end of the loop.
$limit: 4;

@for $i from 1 through $limit {
  $limit: 2;
  a {
    limit: $limit;
    i: $i;
  }
}

================================================================================
`;

