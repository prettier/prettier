exports[`snippet: non_conformant/scss/alpha.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:color";
$x: rgb(0, 255, 255);

div {
  color: rgb(255, $blue: 0, $green: 255);
  background: rgb(123, 45, 6);
//  flah: rgba(0, 0, 0, 1) + #111;
  grah: rgba(#f0e, $alpha: .5);
//  blah: rgba(1,2,3,.6);
  
  floo: $x;
//  bloo: rgba($x, 0.7);
  groo: $x;
  
  $x: rgb(123, 45, 6);
  
  hoo: color.red($x);
  moo: color.green($x);
  poo: color.blue($x);
  
//  goo: mix(rgba(255, 0, 0, 0.5), #00f);
  
  boo: color.invert(#123456);
}

=====================================output=====================================
@use "sass:color";
$x: rgb(0, 255, 255);

div {
  color: rgb(255, $blue: 0, $green: 255);
  background: rgb(123, 45, 6);
  //  flah: rgba(0, 0, 0, 1) + #111;
  grah: rgba(#f0e, $alpha: 0.5);
  //  blah: rgba(1,2,3,.6);

  floo: $x;
  //  bloo: rgba($x, 0.7);
  groo: $x;

  $x: rgb(123, 45, 6);

  hoo: color.red($x);
  moo: color.green($x);
  poo: color.blue($x);

  //  goo: mix(rgba(255, 0, 0, 0.5), #00f);

  boo: color.invert(#123456);
}

================================================================================
`;

