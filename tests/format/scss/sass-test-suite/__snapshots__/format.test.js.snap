exports[`snippet: directives/import/nested.hrx/scope/function/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
.parent {
  // This should be visible to the imported stylesheet. There's not really a
  // good reason for this, but it's the historical behavior so whatever.
  @function local() {
    @return value;
  }

  @import 'other';
}

=====================================output=====================================
.parent {
  // This should be visible to the imported stylesheet. There's not really a
  // good reason for this, but it's the historical behavior so whatever.
  @function local() {
    @return value;
  }

  @import "other";
}

================================================================================
`;

