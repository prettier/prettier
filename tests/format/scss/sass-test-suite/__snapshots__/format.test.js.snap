exports[`snippet: core_functions/meta/get_function/scope.hrx/captures_inner_scope/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:meta";
@function add-two($v) {@error "Should not be called"}
.scope1 {
  @function add-two($v) {@error "Should not be called"}
  .scope2 {
    @function add-two($v) {@error "Should not be called"}
    .scope3 {
      @function add-two($v) {@return $v + 2}

      // Like a normal function call, get-function() will always use the
      // innermost definition of a function.
      a: meta.call(meta.get-function(add-two), 10);
    }
  }
}

=====================================output=====================================
@use "sass:meta";
@function add-two($v) {
  @error "Should not be called";
}
.scope1 {
  @function add-two($v) {
    @error "Should not be called";
  }
  .scope2 {
    @function add-two($v) {
      @error "Should not be called";
    }
    .scope3 {
      @function add-two($v) {
        @return $v + 2;
      }

      // Like a normal function call, get-function() will always use the
      // innermost definition of a function.
      a: meta.call(meta.get-function(add-two), 10);
    }
  }
}

================================================================================
`;

exports[`snippet: core_functions/meta/get_function/scope.hrx/stores_local_scope/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:meta";
$add-two-fn: null;

.scope {
  @function add-two($v) {@return $v + 2}

  // This function reference will still refer to this nested \`add-two\` function
  // even when it goes out of scope.
  $add-two-fn: meta.get-function(add-two) !global;
}

a {b: meta.call($add-two-fn, 10)}

=====================================output=====================================
@use "sass:meta";
$add-two-fn: null;

.scope {
  @function add-two($v) {
    @return $v + 2;
  }

  // This function reference will still refer to this nested \`add-two\` function
  // even when it goes out of scope.
  $add-two-fn: meta.get-function(add-two) !global;
}

a {
  b: meta.call($add-two-fn, 10);
}

================================================================================
`;

