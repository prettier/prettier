exports[`snippet: libsass/delayed.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:list";
$x: a 3/4 b;
$y: hey;

@function foo() {
  @return 3/4;
}

div {
  hoo: 3/4;
  goo: list.nth($x, 2);
  foo: 15 / list.nth($x, 2);
  foo: .25 + list.nth($x, 2);
  coo: 2/3 / list.nth($x, 2);
  bar: $y and true;
  bar: false and true;
  bar: (false) and true;
  @each $elem in $x {
    blah: $elem;
  }
  bloo: foo();
  @warn 2/3;
  blix: "hey #{list.nth($x, 2)} ho";
}

@media screen and (hux: 3/4) {
  div {
    color: red;
  }
}

@warn "blah blah";

div {
  blah: "ho #{list.nth($x, 2) } ho";
}

span {
  fludge: (true and 3/4);
}
=====================================output=====================================
@use "sass:list";
$x: a 3/4 b;
$y: hey;

@function foo() {
  @return 3/4;
}

div {
  hoo: 3/4;
  goo: list.nth($x, 2);
  foo: 15 / list.nth($x, 2);
  foo: 0.25 + list.nth($x, 2);
  coo: 2/3 / list.nth($x, 2);
  bar: $y and true;
  bar: false and true;
  bar: (false) and true;
  @each $elem in $x {
    blah: $elem;
  }
  bloo: foo();
  @warn 2/3;
  blix: "hey #{list.nth($x, 2)} ho";
}

@media screen and (hux: 3/4) {
  div {
    color: red;
  }
}

@warn "blah blah";

div {
  blah: "ho #{list.nth($x, 2) } ho";
}

span {
  fludge: (true and 3/4);
}

================================================================================
`;

exports[`snippet: libsass/div.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:list";
@use "sass:meta";
$x: 3/4;
$xs: hey 3/4 ho;

div {
  /* $x: 3/4 */
  a: $x;
  b: hey $x ho;
  /* $xs: hey 3/4 ho */
  c: $xs;
  d: list.nth($xs, 2);
  e: list.nth($xs, 2) == 0.75;
  f: meta.type-of(list.nth($xs, 2));
}
=====================================output=====================================
@use "sass:list";
@use "sass:meta";
$x: 3/4;
$xs: hey 3/4 ho;

div {
  /* $x: 3/4 */
  a: $x;
  b: hey $x ho;
  /* $xs: hey 3/4 ho */
  c: $xs;
  d: list.nth($xs, 2);
  e: list.nth($xs, 2) == 0.75;
  f: meta.type-of(list.nth($xs, 2));
}

================================================================================
`;

exports[`snippet: libsass/env.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
$x: 0;

div {
  /* 0 */
  font: $x;
  $x: 1 !global;
  /* 1 */
  font: $x;
  span {
    $x: 2 !global;
    /* 2 */
    font: $x;
  }
  /* 2 */
  font: $x;
  p {
    /* 2 */
    font: $x;
  }
}

div {
  @foo {
    $y: 2;
    font: $y;
  }
  @bar {
    $y: 3;
    font: $y;
  }
}

@mixin foo() {
  content: "foo";
  @content;
}

div {
  $z: "whatever";
  @include foo() {
    $z: "block for foo!";
    font: fudge;
  }
  width: $z;
}

=====================================output=====================================
$x: 0;

div {
  /* 0 */
  font: $x;
  $x: 1 !global;
  /* 1 */
  font: $x;
  span {
    $x: 2 !global;
    /* 2 */
    font: $x;
  }
  /* 2 */
  font: $x;
  p {
    /* 2 */
    font: $x;
  }
}

div {
  @foo {
    $y: 2;
    font: $y;
  }
  @bar {
    $y: 3;
    font: $y;
  }
}

@mixin foo() {
  content: "foo";
  @content;
}

div {
  $z: "whatever";
  @include foo() {
    $z: "block for foo!";
    font: fudge;
  }
  width: $z;
}

================================================================================
`;

