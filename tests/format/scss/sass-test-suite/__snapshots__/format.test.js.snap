@mixin flex($grow: 1, $shrink: null, $basis: null) {
  -webkit-box-flex: $grow;
  -webkit-flex: $grow $shrink $basis;
  -moz-box-flex: $grow;
  -moz-flex: $grow $shrink $basis;
  -ms-flex: $grow $shrink $basis;
  flex: $grow $shrink $basis;
}

[flex] {
  @include flex;
}

=====================================output=====================================
@mixin flex($grow: 1, $shrink: null, $basis: null) {
  -webkit-box-flex: $grow;
  -webkit-flex: $grow $shrink $basis;
  -moz-box-flex: $grow;
  -moz-flex: $grow $shrink $basis;
  -ms-flex: $grow $shrink $basis;
  flex: $grow $shrink $basis;
}

[flex] {
  @include flex;
}

================================================================================
`;

exports[`snippet: libsass-closed-issues/issue_492.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
$map: (
  foo: bar,
  baz: monkey,
);

.css {
  @each $key, $value in $map {
    #{$key}: $value;
  }
}

$list: one two, three four five, six seven;

.list {
  @each $foo, $bar, $baz in $list {
    #{$foo}: $bar $baz;
  }
}

=====================================output=====================================
$map: (
  foo: bar,
  baz: monkey,
);

.css {
  @each $key, $value in $map {
    #{$key}: $value;
  }
}

$list:
  one two,
  three four five,
  six seven;

.list {
  @each $foo, $bar, $baz in $list {
    #{$foo}: $bar $baz;
  }
}

================================================================================
`;

