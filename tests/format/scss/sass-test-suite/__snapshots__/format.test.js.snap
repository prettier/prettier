exports[`snippet: libsass-closed-issues/issue_1590/ampersand-against-literal.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@mixin where($sel: null) {
    @if ( & == $sel ) {
        h1 { color: white; }
    } @else {
        h1 { color: blue; }
    }
}
.hive { @include where(); } 
.bee { @include where(".bee"); } 
.amp { @include where(&); } 
.quotedamp { @include where("&"); } 

=====================================output=====================================
@mixin where($sel: null) {
  @if (& == $sel) {
    h1 {
      color: white;
    }
  } @else {
    h1 {
      color: blue;
    }
  }
}
.hive {
  @include where();
}
.bee {
  @include where(".bee");
}
.amp {
  @include where(&);
}
.quotedamp {
  @include where("&");
}

================================================================================
`;

exports[`snippet: libsass-closed-issues/issue_1590/ampersand-as-expression.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@mixin where($sel: null) {
    @if ( & == $sel ) {
        h1 { color: white; }
    } @else {
        h1 { color: blue; }
    }
}
.hive { @include where(); } 
.bee { @include where(&); } 
.queen { @include where("&"); } 

=====================================output=====================================
@mixin where($sel: null) {
  @if (& == $sel) {
    h1 {
      color: white;
    }
  } @else {
    h1 {
      color: blue;
    }
  }
}
.hive {
  @include where();
}
.bee {
  @include where(&);
}
.queen {
  @include where("&");
}

================================================================================
`;

