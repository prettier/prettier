  }
  &hux {
    blah: blah;
  }
  &div.foo#bar[hux] {
    blah: blah;
  }

}
=====================================output=====================================
div {
  &_foo {
    blah: blah;
  }
  &--modifier {
    blach: blah;
  }
  &hux {
    blah: blah;
  }
  &div.foo#bar[hux] {
    blah: blah;
  }
}

================================================================================
`;

