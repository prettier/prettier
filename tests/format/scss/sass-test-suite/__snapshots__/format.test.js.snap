@use "sass:meta";
@use "used";

in-imported {
  parent: meta.inspect(&);
}

================================================================================
`;

exports[`snippet: directives/use/css/import.hrx/nested_import_into_use/_used.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:meta";
// This parent selector will be \`null\`, because used modules are always
// evaluated in a clean context, even if their CSS is then copied into an
// imported file.
in-used {parent: meta.inspect(&)}

=====================================output=====================================
@use "sass:meta";
// This parent selector will be \`null\`, because used modules are always
// evaluated in a clean context, even if their CSS is then copied into an
// imported file.
in-used {
  parent: meta.inspect(&);
}

================================================================================
`;

