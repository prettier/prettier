=====================================output=====================================
@use "sass:color";
$color: #1caf9a;

body {
  test-01: color.change($color, $hue: -240);
  test-03: color.change($color, $hue: 120);
  test-02: color.change($color, $hue: 480);
}

================================================================================
`;

