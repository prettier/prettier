exports[`snippet: non_conformant/basic/59_if_expression.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:string";
$x: 0;
$if-false: whatever;

div {
  foo: if($if-true: hey, $if-false: ho, $condition: true);
  foo: if($if-true: hey, $if-false: ho, $condition: false);
  foo: if($x != 0, if($x, true, false), string.unquote("x is zero"));
  foo: if(false, 1/0, $if-false: $if-false);
}
=====================================output=====================================
@use "sass:string";
$x: 0;
$if-false: whatever;

div {
  foo: if($if-true: hey, $if-false: ho, $condition: true);
  foo: if($if-true: hey, $if-false: ho, $condition: false);
  foo: if($x != 0, if($x, true, false), string.unquote("x is zero"));
  foo: if(false, 1/0, $if-false: $if-false);
}

================================================================================
`;

