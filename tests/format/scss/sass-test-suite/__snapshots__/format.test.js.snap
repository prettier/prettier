                                                      printWidth: 80 (default) |
=====================================input======================================
// This is an error specifically because hsl(0deg 50% none) converts through
// rgb(0 0 0) to lch(none 0 none), so adjusting the hue fails.
@use "sass:color";
a {b: color.complement(hsl(0deg 50% none), $space: lch)}

=====================================output=====================================
// This is an error specifically because hsl(0deg 50% none) converts through
// rgb(0 0 0) to lch(none 0 none), so adjusting the hue fails.
