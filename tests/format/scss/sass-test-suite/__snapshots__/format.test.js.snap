exports[`snippet: libsass-closed-issues/issue_2374.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:color";
$colors: (
    yellow: #ffeb3b
);
@each $name, $color in $colors {
    $amount: 40%;
    @for $i from 0 through 9 {
        .#{$name}-#{($i*100)} { background-color: color.adjust($color, $lightness: $amount) };
        $amount: $amount - 2;
    }
}

$colors: (
    yellow: yellow,
    red: red,
    blue: blue,

);
@each $name, $color in $colors {
    @for $i from 0 through 2 {
        .#{$name}-#{($i*100)} {
          background-color: color.adjust($color, $lightness: 10%)
        };
    }
}


=====================================output=====================================
@use "sass:color";
$colors: (
  yellow: #ffeb3b,
);
@each $name, $color in $colors {
  $amount: 40%;
  @for $i from 0 through 9 {
    .#{$name}-#{($i*100)} {
      background-color: color.adjust($color, $lightness: $amount);
    }
    $amount: $amount - 2;
  }
}

$colors: (
  yellow: yellow,
  red: red,
  blue: blue,
);
@each $name, $color in $colors {
  @for $i from 0 through 2 {
    .#{$name}-#{($i*100)} {
      background-color: color.adjust($color, $lightness: 10%);
    }
  }
}

================================================================================
`;

