exports[`snippet: non_conformant/scss-tests/072_test_mixin_var_and_splat_args_pass_through_keywords.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
