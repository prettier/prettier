exports[`snippet: non_conformant/scss/functions.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@function foo($x, $y, $z) {
  @while $x < $y {
    $z: transform($z);
    @return $z;
  }
}

@function bar($x) {
  @if $x {
    @return YES;
  }
}

div {
  answer: bar(true);
  flanswer: fudge(mux+flux) + mudge(a/b);
}
=====================================output=====================================
@function foo($x, $y, $z) {
  @while $x < $y {
    $z: transform($z);
    @return $z;
  }
}

@function bar($x) {
  @if $x {
    @return YES;
  }
}

div {
  answer: bar(true);
  flanswer: fudge(mux + flux) + mudge(a/b);
}

================================================================================
`;

exports[`snippet: non_conformant/scss/functions-and-mixins.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@function foo() {
  @return "hello";
}

@mixin foo() {
  content: "hello";
}

div {
  span {
    @function length($a, $b, $c, $d) {
      @return $a + $b + $c + $d;
    }

    div {
      content: foo();
      @include foo();
      width: length(1,2,2,3);
    }
  }

  height: length(a b c d e);

}
=====================================output=====================================
@function foo() {
  @return "hello";
}

@mixin foo() {
  content: "hello";
}

div {
  span {
    @function length($a, $b, $c, $d) {
      @return $a + $b + $c + $d;
    }

    div {
      content: foo();
      @include foo();
      width: length(1, 2, 2, 3);
    }
  }

  height: length(a b c d e);
}

================================================================================
`;

