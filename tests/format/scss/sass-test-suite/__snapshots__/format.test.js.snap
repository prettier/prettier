exports[`snippet: non_conformant/scss/directives-in-propsets.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:meta";
$color: red;
$position: 50%;
$x: 0;

@mixin foo() {
  image: url(foo.png);
}

div {
  background: {
    something: {
      color: green;
    }
    @if (meta.type-of($color) == "color") {
      color: $color;
    }
    @if (meta.type-of($position) == "number") {
      position: $position;
      @include foo();
    }
    groo: foo;
  }
  width: $x;
}
=====================================output=====================================
@use "sass:meta";
$color: red;
$position: 50%;
$x: 0;

@mixin foo() {
  image: url(foo.png);
}

div {
  background: {
    something: {
      color: green;
    }
    @if (meta.type-of($color) == "color") {
      color: $color;
    }
    @if (meta.type-of($position) == "number") {
      position: $position;
      @include foo();
    }
    groo: foo;
  }
  width: $x;
}

================================================================================
`;

