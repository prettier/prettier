exports[`snippet: core_functions/string/length.hrx/private_use_character/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:string";
// Dart Sass emits private-use characters as escapes in expanded mode, but it
// should stil treat them as single characters for the purpose of functions.
a {b: string.length("\\E000")}

=====================================output=====================================
@use "sass:string";
// Dart Sass emits private-use characters as escapes in expanded mode, but it
// should stil treat them as single characters for the purpose of functions.
a {
  b: string.length("\\E000");
}

================================================================================
`;

