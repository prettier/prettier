::slotted(.c.d) {x: y}
.e {@extend .c}

::slotted(.f) {x: y}
::slotted(.g) {@extend .f}

=====================================output=====================================
::slotted(.a) {
  x: y;
}

::slotted(.c.d) {
  x: y;
}
.e {
  @extend .c;
}

::slotted(.f) {
  x: y;
}
::slotted(.g) {
  @extend .f;
}

================================================================================
`;

