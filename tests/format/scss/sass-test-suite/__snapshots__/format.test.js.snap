exports[`snippet: libsass/selectors/access.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@mixin selector-access {
  mixin-sees: &;
}

@function function-access() {
  @return &;
}

.foo {
  @include selector-access;
  function-sees: function-access();
}

.bar a {
  @include selector-access;
  function-sees: function-access();
}

.bar,
.baz {
  @include selector-access;
  function-sees: function-access();
}

.qux {
  &.waldo {
    .where & {
      .final {
        @include selector-access;
        function-sees: function-access();
      }
    }
  }
}
=====================================output=====================================
@mixin selector-access {
  mixin-sees: &;
}

@function function-access() {
  @return &;
}

.foo {
  @include selector-access;
  function-sees: function-access();
}

.bar a {
  @include selector-access;
  function-sees: function-access();
}

.bar,
.baz {
  @include selector-access;
  function-sees: function-access();
}

.qux {
  &.waldo {
    .where & {
      .final {
        @include selector-access;
        function-sees: function-access();
      }
    }
  }
}

================================================================================
`;

exports[`snippet: libsass/selectors/function-argument.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:list";
$Selectors: ();

//////////////////////////////
// Add selectors of various depths and makeups
//////////////////////////////
.foo {
  $Selectors: list.append($Selectors, &) !global;
}

.bar a {
  $Selectors: list.append($Selectors, &) !global;
}

.bar,
.baz {
  $Selectors: list.append($Selectors, &) !global;
}

.qux {
  &.waldo {
    .where & {
      .final {
        $Selectors: list.append($Selectors, &) !global;
      }
    }
  }
}

//////////////////////////////
// Display Results
//////////////////////////////
.result {
  length: list.length($Selectors);
  content: $Selectors;
  @for $i from 1 through list.length($Selectors) {
    index: $i;
    length: list.length(list.nth($Selectors, $i));
    content: list.nth($Selectors, $i);
  }
}
=====================================output=====================================
