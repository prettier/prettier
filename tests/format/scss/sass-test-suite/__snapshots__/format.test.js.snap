exports[`snippet: values/numbers/bounds.hrx/precision_limit/at/after_decimal/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
// binary 0.10000000000000000000000000000000000000000000000000001
// 0.5 + 2^-53
// Multiplied by 2^53 so Sass's serialization doesn't remove the precision
@use 'sass:math';
a {b: 0.5000000000000001 * math.pow(2, 53)}

=====================================output=====================================
// binary 0.10000000000000000000000000000000000000000000000000001
// 0.5 + 2^-53
// Multiplied by 2^53 so Sass's serialization doesn't remove the precision
@use "sass:math";
a {
  b: 0.5000000000000001 * math.pow(2, 53);
}

================================================================================
`;

