  color: #181818;
}

@-webkit-keyframes uiDelayedFadeIn {
  0% {
    opacity: 0;
  }
  50% {
    opacity: 0.5;
  }
  100% {
    opacity: 1;
  }
}

@-webkit-keyframes bounce {
  from {
    left: 0px;
  }
  to {
    left: 200px;
  }
}

$name: bounce;

@-webkit-keyframes #{$name} {
  blah: blee;
}

@mixin fudge() {
  @content;
}

foo {
  @include fudge() {
    div {
      color: red;
    }
  }
}

================================================================================
`;

exports[`snippet: libsass/list-evaluation.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:list";
@use "sass:meta";
div {
  $things: red 2/3 blue;
  content: $things;
  content: list.nth($things, 2);
  content: meta.type-of(list.nth($things, 2));
  content: meta.type-of(list.nth($things, 3));
  /**** #{2+2} ****/
  content: (1 / 2 3 / 4) + (5/6 7/8);
  content: (1/2 3/4), (5/6 7/8);
  /**** ****/
  @each $x in 1 2 3/4 {
    foo: $x;
    bar: $x + 1;
  }
  /*** ***/
  stuff: 1, (2 3/4 5), 6;
  stuff: ((1 + 2)/3/4);
}
=====================================output=====================================
@use "sass:list";
@use "sass:meta";
div {
  $things: red 2/3 blue;
  content: $things;
  content: list.nth($things, 2);
  content: meta.type-of(list.nth($things, 2));
  content: meta.type-of(list.nth($things, 3));
  /**** #{2+2} ****/
  content: (1 / 2 3 / 4) + (5/6 7/8);
  content: (1/2 3/4), (5/6 7/8);
  /**** ****/
  @each $x in 1 2 3/4 {
    foo: $x;
    bar: $x + 1;
  }
  /*** ***/
  stuff: 1, (2 3/4 5), 6;
  stuff: ((1 + 2)/3/4);
}

================================================================================
`;

exports[`snippet: libsass/lists.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:list";
@use "sass:meta";
div {
  $list: list.append(1/2 3, 4);
  content: (1 2 3) == (1, 2, 3);
  content: (1 2 3) == (1 2 3);
  content: var $list;
  content: lit (1/2 3 4);
  content: (1/2 3 4) == $list;
  a: list.length((1/2 3 4)), list.length($list);
  b: list.nth((1/2 3 4), 1), list.nth($list, 1);
  content: (1/2 3 4) == (1/2 3 4);
  /***/
  content: list.length($list);
  content: meta.type-of(list.nth($list, 1));
  content: list.nth($list, 1);
  content: list.nth(1/2 3 4, 1);
  $a: 1 2 3;
  $b: (1 2 3);
  content: $a == $b;
  content: 1 2 () 3;
  color: red == #ff0000;
  $color-list : fudge red blue;
  color: list.nth($color-list, 2) == #ff0000;
  color: list.nth($color-list, 2) == red;
}
=====================================output=====================================
@use "sass:list";
@use "sass:meta";
div {
  $list: list.append(1/2 3, 4);
  content: (1 2 3) == (1, 2, 3);
  content: (1 2 3) == (1 2 3);
  content: var $list;
  content: lit (1/2 3 4);
  content: (1/2 3 4) == $list;
  a: list.length((1/2 3 4)), list.length($list);
  b: list.nth((1/2 3 4), 1), list.nth($list, 1);
  content: (1/2 3 4) == (1/2 3 4);
  /***/
  content: list.length($list);
  content: meta.type-of(list.nth($list, 1));
  content: list.nth($list, 1);
  content: list.nth(1/2 3 4, 1);
  $a: 1 2 3;
  $b: (1 2 3);
  content: $a == $b;
  content: 1 2 () 3;
  color: red == #ff0000;
  $color-list: fudge red blue;
  color: list.nth($color-list, 2) == #ff0000;
  color: list.nth($color-list, 2) == red;
}

================================================================================
`;

exports[`snippet: libsass/media.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@media all and (min-width: 960px) {
  b {
    font-weight: normal;
  }
}

@media (min-width: 980px) {
  a {
    color: red;
  }
}

@media all {
  /* hey */
  p {
    color: blue;
    a {
      color: green;
      &:after {
        content: ">>";
      }
    }
  }
  span {
    display: inline-block;
  }
}

a b c {
  /* a */
  blee: blee;
  /* b */
  d e f {
    blah: blah;
    bloo: bloo;
  }
  /* c */
  g h, i j {
    @media print and (foo: 1 2 3), (bar: 3px hux(muz)), not screen {
      /* aa */
      hey: ho;
      /* bb */
      k l m {
        hee: fee;
      }
      /* cc */
      haa: hoo;
      /* dd */
    }
  }
  /* d */
  blah: blah;
}

@mixin simple-media-query($max-width, $min-width) {
  @media only screen and (max-width : $max-width) and (min-width : $min-width) {
    @content;
  }
}

@mixin test($value) {
  border-color: $value;
}

body {
  @include test("#ccc");
  @include simple-media-query(900px, 400px) {
    border-color: black;
  }
}

$foo: 23;
$bar: 45;

@media only screen and (max-width: $foo) and (min-width: $bar) {
  hey {
    ho: hoo;
  }
}

@media (max-width: 200) and (min-width: 100) {
  div {
    color: red;
  }
}

@media not bl#{ah} and (width: 200px) {
  div {
    color: brown, blue, black;
  }
}

@mixin media($var1, $var2) {
  @media screen and ($var1: $var2) {
    @content;
  }
}

@include media(max-device-width, 500px) {
  foo {
    bar: "works";
  }
}

div {
  color: red;
  span {
    color: blue;
    @media screen {
      p {
        color: green;
      }
    }
  }
}
=====================================output=====================================
@media all and (min-width: 960px) {
  b {
    font-weight: normal;
  }
}

@media (min-width: 980px) {
  a {
    color: red;
  }
}

@media all {
  /* hey */
  p {
    color: blue;
    a {
      color: green;
      &:after {
        content: ">>";
      }
    }
  }
  span {
    display: inline-block;
  }
}

a b c {
  /* a */
  blee: blee;
  /* b */
  d e f {
    blah: blah;
    bloo: bloo;
  }
  /* c */
  g h,
  i j {
    @media print and (foo: 1 2 3), (bar: 3px hux(muz)), not screen {
      /* aa */
      hey: ho;
      /* bb */
      k l m {
        hee: fee;
      }
      /* cc */
      haa: hoo;
      /* dd */
    }
  }
  /* d */
  blah: blah;
}

@mixin simple-media-query($max-width, $min-width) {
  @media only screen and (max-width: $max-width) and (min-width: $min-width) {
    @content;
  }
}

@mixin test($value) {
  border-color: $value;
}

body {
  @include test("#ccc");
  @include simple-media-query(900px, 400px) {
    border-color: black;
  }
}

$foo: 23;
$bar: 45;

@media only screen and (max-width: $foo) and (min-width: $bar) {
  hey {
    ho: hoo;
  }
}

@media (max-width: 200) and (min-width: 100) {
  div {
    color: red;
  }
}

@media not bl#{ah} and (width: 200px) {
  div {
    color: brown, blue, black;
  }
}

@mixin media($var1, $var2) {
  @media screen and ($var1: $var2) {
    @content;
  }
}

@include media(max-device-width, 500px) {
  foo {
    bar: "works";
  }
}

div {
  color: red;
  span {
    color: blue;
    @media screen {
      p {
        color: green;
      }
    }
  }
}

================================================================================
`;

