exports[`snippet: css/media/bubbling.hrx/preserve_merge_after_bubble/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
// Regression test for sass/dart-sass#777
@media (a: b) {
  @media (c: d) {
    e {f: g}
  }

  h {i: j}
  k {l: m}
}

=====================================output=====================================
// Regression test for sass/dart-sass#777
@media (a: b) {
  @media (c: d) {
    e {
      f: g;
    }
  }

  h {
    i: j;
  }
  k {
    l: m;
  }
}

================================================================================
`;

exports[`snippet: css/media/bubbling.hrx/unmergeable_and_merged/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
// Regression test for sass/sass#3384. In Dart Sass, this caused a bug because
// we were asking "has this media query been merged?" to determine whether to
// bubble it up through parent queries, disregarding whether it had been merged
// with *that particular query*.
@media not a {
  @media (b) {
    @media (c) {
      d {e: f}
    }
  }
}

=====================================output=====================================
// Regression test for sass/sass#3384. In Dart Sass, this caused a bug because
// we were asking "has this media query been merged?" to determine whether to
// bubble it up through parent queries, disregarding whether it had been merged
// with *that particular query*.
@media not a {
  @media (b) {
    @media (c) {
      d {
        e: f;
      }
    }
  }
}

================================================================================
`;

