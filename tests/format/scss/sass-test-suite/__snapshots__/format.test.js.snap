exports[`snippet: directives/use/member/global.hrx/variable_assignment/nested/global/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "other" as *;

a {
  // A nested variable assignment that doesn't have a namespace but is !global
  // assigns to a global module's variable if one exists.
  $member: new value !global;

  b: get-member();
}

=====================================output=====================================
@use "other" as *;

a {
  // A nested variable assignment that doesn't have a namespace but is !global
  // assigns to a global module's variable if one exists.
  $member: new value !global;

  b: get-member();
}

================================================================================
`;

exports[`snippet: directives/use/member/global.hrx/variable_assignment/nested/global/other.scss format 1`] = `
