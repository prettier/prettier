exports[`snippet: libsass-closed-issues/issue_1171.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:list";
@function foo($initial, $args...) {
  $args: list.append($args, 3);

  @return bar($initial, $args...);
}

@function bar($args...) {
  @return list.length($args);
}

@function baz($initial, $args...) {
  $args: list.append($args, 3);

  @return list.nth($args, 1);
}

.test {
  foo: foo(1, 2);
  baz: baz(1, 2);
}
=====================================output=====================================
@use "sass:list";
@function foo($initial, $args...) {
  $args: list.append($args, 3);

  @return bar($initial, $args...);
}

@function bar($args...) {
  @return list.length($args);
}

@function baz($initial, $args...) {
  $args: list.append($args, 3);

  @return list.nth($args, 1);
}

.test {
  foo: foo(1, 2);
  baz: baz(1, 2);
}

================================================================================
`;

