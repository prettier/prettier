  color: color.grayscale(#369);
  color: saturate(#369);
  color: color.adjust(#369, $saturation: 20%);
  color: color.invert(#369);
  color: color.alpha(#369);
}

div.numbers {
  filter: grayscale(30%);
  filter: saturate(30%);
  filter: invert(30%);
