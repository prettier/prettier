$green-rgb: rgb(0, 255, 0);
$green-rgba-t: rgba(0, 255, 0, 0.5);
$green-rgba-s: rgba(0, 255, 0, 1);
$offgreen: #00ff01;
$silver: silver;
$silver-hex: #ddd;

a {
  q: silver;
  r: #ddd;
  s: green;
  t: #00ff00;
  v: #0f0;
  w: rgb(0, 255, 0);
  x: rgba(0, 255, 0, 0.5);
