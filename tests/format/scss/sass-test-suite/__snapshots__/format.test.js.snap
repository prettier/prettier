exports[`snippet: core_functions/string/unique_id.hrx/is_identifier/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:selector";
@use "sass:string";
// Every call to unique-id() should return a valid CSS identifier. We can't test
// this directly, so we make sure it can parse as a class selector with
// selector-parse().
@for $i from 1 to 1000 {
  $_: selector.parse(".#{string.unique-id()}");
}

=====================================output=====================================
@use "sass:selector";
@use "sass:string";
// Every call to unique-id() should return a valid CSS identifier. We can't test
// this directly, so we make sure it can parse as a class selector with
// selector-parse().
@for $i from 1 to 1000 {
  $_: selector.parse(".#{string.unique-id()}");
}

================================================================================
`;

exports[`snippet: core_functions/string/unique_id.hrx/is_unique/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:map";
@use "sass:string";
// As the name suggests, every call to unique-id() should return a different
// value.
$ids: ();
@for $i from 1 to 1000 {
  $id: string.unique-id();
  @if map.has-key($ids, $id) {
    @error "#{$id} generated more than once";
  }

  $ids: map.merge($ids, ($id: null));
}

=====================================output=====================================
@use "sass:map";
@use "sass:string";
// As the name suggests, every call to unique-id() should return a different
// value.
$ids: ();
@for $i from 1 to 1000 {
  $id: string.unique-id();
  @if map.has-key($ids, $id) {
    @error "#{$id} generated more than once";
  }

  $ids: map.merge(
    $ids,
    (
      $id: null,
    )
  );
}

================================================================================
`;

exports[`snippet: core_functions/string/unquote.hrx/empty/input.scss format 1`] = `
