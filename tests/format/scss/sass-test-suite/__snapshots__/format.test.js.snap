exports[`snippet: libsass-closed-issues/issue_2246.hrx/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@use "sass:math";
@mixin foo($option: 'foo') {
     // Create a unique, random placeholder to store styles
    $placeholder : $option + math.random(9999);

    // Store the styles in the placeholder
    @at-root %#{$placeholder} {
        content: 'foo';
    }

    @at-root {
        .bar {
            @extend %#{$placeholder};
        }
    }
}

@mixin bar($option) {
    @include foo($option);
}

.foo {
    @include bar('baz');
}
=====================================output=====================================
@use "sass:math";
@mixin foo($option: "foo") {
  // Create a unique, random placeholder to store styles
  $placeholder: $option + math.random(9999);

  // Store the styles in the placeholder
  @at-root %#{$placeholder} {
    content: "foo";
  }

  @at-root {
    .bar {
      @extend %#{$placeholder};
    }
  }
}

@mixin bar($option) {
  @include foo($option);
}

.foo {
  @include bar("baz");
}

================================================================================
`;

