exports[`snippet: directives/extend/after_target.hrx/multiple_recursive/input.scss format 1`] = `
====================================options=====================================
parsers: ["scss"]
                                                      printWidth: 80 (default) |
=====================================input======================================
// Regression test for sass/dart-sass#1109.
.a .b {
  c: d;
}

.a.mod1, .a.mod2 {
  @extend .a, .b;
}
.a.mod3, .a.mod4 {
  @extend .a, .b;
}
.a.mod5, .a.mod6 {
  @extend .a, .b;
}

=====================================output=====================================
// Regression test for sass/dart-sass#1109.
.a .b {
  c: d;
}

.a.mod1,
.a.mod2 {
  @extend .a, .b;
}
.a.mod3,
.a.mod4 {
  @extend .a, .b;
}
.a.mod5,
.a.mod6 {
  @extend .a, .b;
}

================================================================================
`;

