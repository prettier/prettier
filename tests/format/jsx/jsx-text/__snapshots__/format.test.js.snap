// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`code-point.jsx format 1`] = `
====================================options=====================================
parsers: ["babel", "typescript", "flow"]
                                                      printWidth: 80 (default) |
=====================================input======================================
_ = <a>&#x110000; &#1114112;</a>
_ = <a>&#1234;</a>
_ = <a>&#xABC;</a>
_ = <a>&#00000000000000000000001234;</a>
_ = <a>&#x0000000000000000000000ABC;</a>
_ = <a>&#0000;</a>
_ = <a>&#x10ffff;</a>
_ = <a>&#128; &#x80;</a>

=====================================output=====================================
_ = <a>&#x110000; &#1114112;</a>;
_ = <a>&#1234;</a>;
_ = <a>&#xABC;</a>;
_ = <a>&#00000000000000000000001234;</a>;
_ = <a>&#x0000000000000000000000ABC;</a>;
_ = <a>&#0000;</a>;
_ = <a>&#x10ffff;</a>;
_ = <a>&#128; &#x80;</a>;

================================================================================
`;

exports[`named-entries.jsx format 1`] = `
====================================options=====================================
parsers: ["babel", "typescript", "flow"]
                                                      printWidth: 80 (default) |
=====================================input======================================
_ = <a>&there4;</a>
_ = <a>&constructor;</a>
_ = <a>&amp;</a>
_ = <a>&amp</a>
_ = <a>&foo;</a>

// HTML5 entries
_ = <a>&rbrace;</a>

=====================================output=====================================
_ = <a>&there4;</a>;
_ = <a>&constructor;</a>;
_ = <a>&amp;</a>;
_ = <a>&amp</a>;
_ = <a>&foo;</a>;

// HTML5 entries
_ = <a>&rbrace;</a>;

================================================================================
`;
