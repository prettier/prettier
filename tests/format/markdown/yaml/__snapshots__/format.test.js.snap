exports[`complex.md - {"proseWrap":"always"} format 1`] = `
====================================options=====================================
parsers: ["markdown"]
proseWrap: "always"
                                                      printWidth: 80 (default) |
=====================================input======================================
---
- hello:    world
-         123
---

# something

=====================================output=====================================
---
- hello: world
- 123
---

# something

================================================================================
`;

