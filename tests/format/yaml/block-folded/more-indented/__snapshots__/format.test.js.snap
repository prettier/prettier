exports[`more-indented.yml - {"proseWrap":"always","printWidth":30} format 1`] = `
====================================options=====================================
parsers: ["yaml"]
printWidth: 30
proseWrap: "always"
              printWidth: 30 |
=====================================input======================================
OffendingTextUsesFoldingBlockScalar:
  - >
    First Line.
             This line is indented and exceeds the print width, but shouldn't be broken, since it will insert a line break where there isn't one currently.
    This is another line, which should be preceded by a line break, but is safe to break!

consecutive: >-
  Ordinary text can be wrapped safely across multiple lines when it is long enough.
    This more-indented line must stay intact even when it exceeds the configured print width.
    This consecutive more-indented line must also retain its own line break.
  Ordinary text after the indented section can once again be wrapped safely.

explicit: >2-
    This first line is more indented than the explicit indentation indicator and must not wrap.
    This second line must keep its line break as well, even when prose wrapping is disabled.
  Ordinary text can still wrap after these indented lines without changing its value.

keep: >+
  Ordinary text can be wrapped safely across multiple lines when it is long enough.
    This more-indented line must stay intact even when it exceeds the configured print width.
  Ordinary text after the indented section can once again be wrapped safely.

next: value

