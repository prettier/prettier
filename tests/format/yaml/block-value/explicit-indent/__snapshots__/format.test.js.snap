exports[`scalars.yml - {"tabWidth":1,"proseWrap":"always"} format 1`] = `
====================================options=====================================
parsers: ["yaml"]
proseWrap: "always"
tabWidth: 1
                                                      printWidth: 80 (default) |
=====================================input======================================
