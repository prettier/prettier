exports[`method.js format 1`] = `
====================================options=====================================
parsers: ["flow"]
                                                      printWidth: 80 (default) |
=====================================input======================================
type T = { method: () => void };
type T2 = { method(): void };
declare class X { method(): void }
declare function f(): void;
var f: () => void;

declare class X {
  static deserialize(): mixed,
  static deserialize: () => mixed,
}

interface I {
  static(): number;
}

=====================================output=====================================
type T = { method: () => void };
type T2 = { method(): void };
declare class X {
  method(): void;
}
declare function f(): void;
var f: () => void;

declare class X {
  static deserialize(): mixed;
  static deserialize: () => mixed;
}

interface I {
  static(): number;
}

================================================================================
`;

exports[`method-signature.js format 1`] = `
====================================options=====================================
parsers: ["flow"]
                                                      printWidth: 80 (default) |
=====================================input======================================
type Foo = {
  get(key: "foo"): \`
  \`;
};
type Foo = {
  get(key: "foo"): \`
   \${x}
  \`;
};
type Foo = {
  get(key: "foo"): \`\`;
};
type Foo = {
  get(key: "foo"): \`\${x}\`;
};

type Bar = {
  get(key: "bar"): {
    bar: "bar"
  };
}
type Bar = {
  get(key: "bar"): { bar: "bar" };
}

=====================================output=====================================
type Foo = {
  get(key: "foo"): \`
  \`,
};
type Foo = {
  get(key: "foo"): \`
   \${x}
  \`,
};
type Foo = {
  get(key: "foo"): \`\`,
};
type Foo = {
  get(key: "foo"): \`\${x}\`,
};

type Bar = {
  get(key: "bar"): {
    bar: "bar",
  },
};
type Bar = {
  get(key: "bar"): { bar: "bar" },
};

================================================================================
`;

