// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`in-out-variance.js format 1`] = `
====================================options=====================================
parsers: ["flow"]
                                                      printWidth: 80 (default) |
=====================================input======================================
type Contravariant<  in   T  > = T;

type Covariant<  out   T  > = T;

type Mixed<  in   T,   out   U  > = T;

type InNamedIn<  in   in  > = void;

type OutNamedOut<  out   out  > = void;

type InWithBound<  in   T:   number  > = T;

type OutWithDefault<  out   T  =   string  > = T;

=====================================output=====================================
type Contravariant<in T> = T;

type Covariant<out T> = T;

type Mixed<in T, out U> = T;

type InNamedIn<in in> = void;

type OutNamedOut<out out> = void;

type InWithBound<in T: number> = T;

type OutWithDefault<out T = string> = T;

================================================================================
`;

exports[`invariant.js format 1`] = `
====================================options=====================================
parsers: ["flow"]
                                                      printWidth: 80 (default) |
=====================================input======================================
type Invariant<  in   out   T  > = { get: () => T, set: (value: T) => void };

=====================================output=====================================
type Invariant<in out T> = { get: () => T, set: (value: T) => void };

================================================================================
`;

exports[`invariant.js format[hermes] 1`] = `
"'>' expected at end of type parameters (1:29)
> 1 | type Invariant<  in   out   T  > = { get: () => T, set: (value: T) => void };
    |                             ^
  2 |
Cause: '>' expected at end of type parameters (1:28)
type Invariant<  in   out   T  > = { get: () => T, set: (value: T) => void };
              ~~~~~~~~~~~~~~^"
`;
