declare export let b: string;
declare export const c: string;

=====================================output=====================================
declare var a: string;
declare let b: string;
declare const c: string;
declare export var a: string;
declare export let b: string;
declare export const c: string;

================================================================================
`;

exports[`initializer.js format 1`] = `
