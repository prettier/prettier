// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`constructor.js.flow format 1`] = `
====================================options=====================================
parsers: ["flow"]
                                                      printWidth: 80 (default) |
=====================================input======================================
declare class C {
  constructor();
  constructor(value: number);
  constructor(value: string, ...rest: string[]);
  constructor(/* parameter */ value: number);
  constructor(): void;
  method(): void;
  callback: () => void;
}

=====================================output=====================================
declare class C {
  constructor();
  constructor(value: number);
  constructor(value: string, ...rest: string[]);
  constructor(/* parameter */ value: number);
  constructor(): void;
  method(): void;
  callback: () => void;
}

================================================================================
`;

exports[`constructor.js.flow format[hermes] 1`] = `
"':' expected in function type annotation (2:16)
  1 | declare class C {
> 2 |   constructor();
    |                ^
  3 |   constructor(value: number);
  4 |   constructor(value: string, ...rest: string[]);
  5 |   constructor(/* parameter */ value: number);
Cause: ':' expected in function type annotation (2:15)
  constructor();
  ~~~~~~~~~~~~~^"
`;

exports[`indexer.js format 1`] = `
====================================options=====================================
parsers: ["flow"]
                                                      printWidth: 80 (default) |
=====================================input======================================
declare class A {
  [number]: boolean;
  static [string]: boolean;
}

// Read-only
declare class B {
  +[number]: boolean;
  static +[string]: boolean;
}

declare class C {
  [Symbol.iterator]: () => Iterator<number>;
}

=====================================output=====================================
declare class A {
  [number]: boolean;
  static [string]: boolean;
}

// Read-only
declare class B {
  +[number]: boolean;
  static +[string]: boolean;
}

declare class C {
  [Symbol.iterator]: () => Iterator<number>;
}

================================================================================
`;

exports[`initializer.js.flow format 1`] = `
====================================options=====================================
parsers: ["flow"]
                                                      printWidth: 80 (default) |
=====================================input======================================
declare class C {
  readonly x = 42;
  static readonly y = "value";
  readonly annotated: 42 = 42;
  readonly typed: number;
  readonly leading = /* initializer */ 42;
  readonly before /* before initializer */ = "value";
  readonly trailing = 42 /* after initializer */;
  readonly ownLine =
    // initializer
    42;
}

=====================================output=====================================
declare class C {
  readonly x = 42;
  static readonly y = "value";
  readonly annotated: 42 = 42;
  readonly typed: number;
  readonly leading = /* initializer */ 42;
  readonly before /* before initializer */ = "value";
  readonly trailing = 42; /* after initializer */
  readonly ownLine =
    // initializer
    42;
}

================================================================================
`;

exports[`initializer.js.flow format[hermes] 1`] = `
"':' or '?' expected in property type annotation (2:14)
  1 | declare class C {
> 2 |   readonly x = 42;
    |              ^
  3 |   static readonly y = "value";
  4 |   readonly annotated: 42 = 42;
  5 |   readonly typed: number;
Cause: ':' or '?' expected in property type annotation (2:13)
  readonly x = 42;
  ~~~~~~~~~~~^"
`;
