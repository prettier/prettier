// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`private.js.flow - {"semi":false} format 1`] = `
====================================options=====================================
parsers: ["flow"]
semi: false
                                                      printWidth: 80 (default) |
=====================================input======================================
declare class C { #x; }

declare class Fields {
// First private field
#first;
#second /* trailing */;
value: string;
/* private */ #third;
method(): void;
}

=====================================output=====================================
declare class C {
  #x;
}

declare class Fields {
  // First private field
  #first;
  #second; /* trailing */
  value: string;
  /* private */ #third;
  method(): void;
}

================================================================================
`;

exports[`private.js.flow - {"semi":false} format[hermes] 1`] = `
"invalid property name - must be a string, number or identifier (1:19)
> 1 | declare class C { #x; }
    |                   ^
  2 |
  3 | declare class Fields {
  4 | // First private field
Cause: invalid property name - must be a string, number or identifier (1:18)
declare class C { #x; }
                  ^~"
`;

