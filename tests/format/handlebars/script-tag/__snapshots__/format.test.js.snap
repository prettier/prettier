=====================================output=====================================
<script
  src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"
></script>
<script></script>

<script>
  shouldFormat();
</script>

<script type="text/javascript">
  shouldFormat();
</script>

<script type="module">
  import a from "a";
</script>

<script>
  // Shuold not support TLA in script without \`[type="module"]\`
  await shouldNotFormat   (   a   );
</script>

<script type="module">
  await shouldFormat(a);
</script>

<script type="application/ld+json">
  {   "should"   :   "not format" }
</script>

<script>
  shouldNotFormat( '{{user.name}}' )
  {{#if debug}}shouldNotFormat( 'debug' ){{/if}}
</script>

<script>
  const template = html\`<div>
    <script>
      shouldFormat();
    <\\/script>
  </div>\`;
</script>
================================================================================
