exports[`right-nested.js - {"experimentalOperatorPosition":"start"} format 1`] = `
====================================options=====================================
experimentalOperatorPosition: "start"
parsers: ["babel", "flow", "typescript"]
                                                      printWidth: 80 (default) |
=====================================input======================================
x = first && (
  // Check the next operand.
  second && third
);

x = first && (
  // Build the fallback.
  second && [third, fourth]
);

x = first && ((
  // Check both operands.
  second && third
) && fourth);

=====================================output=====================================
x =
  first
  // Check the next operand.
  && second
  && third;

x = first
  // Build the fallback.
  && second && [third, fourth];

x =
  first
  // Check both operands.
  && second
  && third
  && fourth;

================================================================================
`;

