const a = (x) => x?.(bar) ?? baz;
const b = (user) => user?.profile?.settings?.theme ?? "dark";
const c = (item, fallback) => item?.computePrice() ?? fallback;
const d = (data) => data?.items?.[0] ?? null;
const e = (x) => x?.foo?.() ?? "fallback";

================================================================================
`;
