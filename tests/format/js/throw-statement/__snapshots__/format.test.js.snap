exports[`jsx.js format 1`] = `
====================================options=====================================
parsers: ["babel", "flow", "typescript"]
                                                      printWidth: 80 (default) |
=====================================input======================================
function foo() {
  throw <Bar />;
}

function foo() {
  throw <Bar>baz</Bar>;
}

function foo() {
  throw <Bar baz={baz} />;
}

function foo() {
  throw <Bar baz={baz}>foo</Bar>;
}

function foo() {
  throw <></>;
}

function foo() {
  throw <>foo</>;
}

=====================================output=====================================
