exports[`async-do-expressions.js format 1`] = `
====================================options=====================================
parsers: ["babel"]
                                                      printWidth: 80 (default) |
=====================================input======================================
async do {
  1;
};

(async do {});

let x = async do {
  if (foo()) { f() }
  else if (bar()) { g() }
  else { h() }
};

async do {
  await 42
}

let x = async do {
  let tmp = f();
  tmp * tmp + 1
};

=====================================output=====================================
(async do {
  1;
});

(async do {});

