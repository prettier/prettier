// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`interpolation.less format 1`] = `
====================================options=====================================
parsers: ["less"]
                                                      printWidth: 80 (default) |
=====================================input======================================
// https://github.com/shellscape/postcss-less/pull/159
@{selector}-title{ @{prop}-size: @{color} }

=====================================output=====================================
// https://github.com/shellscape/postcss-less/pull/159
@{selector}-title {
  @{prop}-size: @{color};
}

================================================================================
`;

exports[`props.less format 1`] = `
====================================options=====================================
parsers: ["less"]
                                                      printWidth: 80 (default) |
=====================================input======================================
.test {
  \${prop-name}: red;
  border-\${prop-name}-width: 2px;
  *-z-\${prop-name}: 1px dashed blue;
  \${my}-\${prop-name}-\${value}: green;
}

=====================================output=====================================
.test {
  \${prop-name}: red;
  border-\${prop-name}-width: 2px;
  *-z-\${prop-name}: 1px dashed blue;
  \${my}-\${prop-name}-\${value}: green;
}

================================================================================
`;

exports[`selector.less format 1`] = `
====================================options=====================================
parsers: ["less"]
                                                      printWidth: 80 (default) |
=====================================input======================================
@prefix: foo;

@{prefix}-title{
  color: red;
}

=====================================output=====================================
@prefix: foo;

@{prefix}-title {
  color: red;
}

================================================================================
`;

exports[`value.less format 1`] = `
====================================options=====================================
parsers: ["less"]
                                                      printWidth: 80 (default) |
=====================================input======================================
a {
  --from-chained: @{theme[@nested][name]};
  color: @{theme[@nested][name]};
}

=====================================output=====================================
a {
  --from-chained: @{theme[@nested][name]};
  color: @{theme[@nested][name]};
}

================================================================================
`;
