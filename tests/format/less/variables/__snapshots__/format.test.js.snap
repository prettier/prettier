input {
  @{just-text-type-input-selectors} {
    color: blue;
  }
}

@sel: &:not([type="file"]);
@hover: &:hover;
@focus: &:focus-visible;
@compound: & > .a + .b;
@list: &:hover, &:focus;
@custom-selector: &:hover;
@broken: &::;

================================================================================
`;

