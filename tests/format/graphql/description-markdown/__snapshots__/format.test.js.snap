exports[`values-and-ignore.graphql - {"embeddedLanguageFormatting":"off"} format 1`] = `
====================================options=====================================
embeddedLanguageFormatting: "off"
parsers: ["graphql"]
                                                      printWidth: 80 (default) |
=====================================input======================================
"Use **this** single-line string unchanged.  "
scalar SingleLine

""""""
scalar Empty

# prettier-ignore
"""
*  Unformatted
\`\`\`json
{"ignored":true}
\`\`\`
"""
type Ignored { field:String }

query Example($value: String = """
\`\`\`json
{"default":true}
\`\`\`
""") {
  field(argument: """
\`\`\`javascript
const data={a:1}
\`\`\`
""")
}

input Defaults {
  value: String = """
*  An ordinary string value
\`\`\`json
{"data":true}
\`\`\`
"""
}

=====================================output=====================================
"Use **this** single-line string unchanged.  "
scalar SingleLine

"""
"""
scalar Empty

# prettier-ignore
"""
*  Unformatted
\`\`\`json
{"ignored":true}
\`\`\`
"""
type Ignored { field:String }

query Example(
  $value: String = """
  \`\`\`json
  {"default":true}
  \`\`\`
  """
) {
  field(
    argument: """
    \`\`\`javascript
    const data={a:1}
    \`\`\`
    """
  )
}

input Defaults {
  value: String = """
  *  An ordinary string value
  \`\`\`json
  {"data":true}
  \`\`\`
  """
}

================================================================================
`;

