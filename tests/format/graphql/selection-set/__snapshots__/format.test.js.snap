// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`empty-1.graphql format 1`] = `
====================================options=====================================
parsers: ["graphql"]
                                                      printWidth: 80 (default) |
=====================================input======================================
{ a deep { } ...Frag } fragment Frag on Type { }

=====================================output=====================================
{
  a
  deep {}
  ...Frag
}
fragment Frag on Type {}

================================================================================
`;

