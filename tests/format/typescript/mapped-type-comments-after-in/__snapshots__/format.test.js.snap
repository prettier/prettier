    Key in
      // keys
      "a" | "b"
  ]: Value;
};

type IgnoreUnion = {
  [
    Key in // prettier-ignore
    "a"  |  "b"
  ]: Value;
};

type IgnoreReference = {
  [
    Key in
    /* prettier-ignore */
    Keys<  Source  >
  ]: Value;
};

type ModifiersAndRemapping = {
  -readonly [
    Key in // keys
    keyof Source as \`get\${Capitalize<Key>}\`
  ]-?: Value;
};

type KeywordInComment = {
  [
    Key /* in this comment */ in // keys
    keyof Source
  ]: Value;
};

type KeywordInName = {
  [
    input in // keys
    keyof Source
  ]: Value;
};

type BeforeKeyword = {
