// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`filtered-namespaces.ts format 1`] = `
====================================options=====================================
parsers: ["typescript"]
                                                      printWidth: 80 (default) |
=====================================input======================================
import type { a } as ns from "x";
export { a } as ns2 from "x";

=====================================output=====================================
import type { a } as ns from "x";
export { a } as ns2 from "x";

================================================================================
`;

exports[`filtered-namespaces.ts format[oxc-ts] 1`] = `
"Expected \`from\` but found \`as\` (1:19)
> 1 | import type { a } as ns from "x";
    |                   ^^
  2 | export { a } as ns2 from "x";
  3 |"
`;

exports[`filtered-namespaces.ts format[typescript] 1`] = `
"'from' expected. (1:19)
> 1 | import type { a } as ns from "x";
    |                   ^
  2 | export { a } as ns2 from "x";
  3 |
Cause: 'from' expected."
`;

exports[`filtered-namespaces.ts format[yuku-ts] 1`] = `
"Expected 'from' after the import clause, but found 'as' (1:19)
> 1 | import type { a } as ns from "x";
    |                   ^^
  2 | export { a } as ns2 from "x";
  3 |"
`;

exports[`type-newline-as.ts format 1`] = `
====================================options=====================================
parsers: ["typescript"]
                                                      printWidth: 80 (default) |
=====================================input======================================
export type { A }
as(1);
type A = 1;

=====================================output=====================================
export type { A };
as(1);
type A = 1;

================================================================================
`;

exports[`typescript-type-modifier.ts format[babel-ts] 1`] = `
