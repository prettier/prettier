// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`await.ts format 1`] = `
====================================options=====================================
parsers: ["typescript", "flow"]
                                                      printWidth: 80 (default) |
=====================================input======================================
async (a) => (await a!) ** 6;

async function f() { return (await foo())!; }

function* g() { return (yield foo())!; }

=====================================output=====================================
async (a) => (await a!) ** 6;

async function f() {
  return (await foo())!;
}

function* g() {
  return (yield foo())!;
}

================================================================================
`;

exports[`await.ts format[hermes] 1`] = `
"')' expected at end of parenthesized expression (1:22)
> 1 | async (a) => (await a!) ** 6;
    |                      ^
  2 |
  3 | async function f() { return (await foo())!; }
  4 |
Cause: ')' expected at end of parenthesized expression (1:21)
async (a) => (await a!) ** 6;
             ~~~~~~~~^"
`;

exports[`braces.ts format 1`] = `
====================================options=====================================
parsers: ["typescript", "flow"]
                                                      printWidth: 80 (default) |
=====================================input======================================
const myFunction2 = (key: string): number =>
  ({
    a: 42,
    b: 42,
  }[key]!)

const myFunction3 = key => ({}!.a);

const f = ((a) => {log(a)})!;

if (a) ({ a, ...b }.a())!.c();

(function() {})!()

class a extends ({}!) {}

=====================================output=====================================
const myFunction2 = (key: string): number =>
  ({
    a: 42,
    b: 42,
  })[key]!;

const myFunction3 = (key) => ({})!.a;

const f = ((a) => {
  log(a);
})!;

if (a) ({ a, ...b }).a()!.c();

(function () {})!();

class a extends ({}!) {}

================================================================================
`;

exports[`braces.ts format[hermes] 1`] = `
"')' expected at end of parenthesized expression (5:9)
  3 |     a: 42,
  4 |     b: 42,
> 5 |   }[key]!)
    |         ^
  6 |
  7 | const myFunction3 = key => ({}!.a);
  8 |
Cause: ')' expected at end of parenthesized expression (5:8)
  }[key]!)
        ^
note: started here (2:2)
  ({
  ^"
`;

exports[`comments.ts format 1`] = `
====================================options=====================================
parsers: ["typescript", "flow"]
                                                      printWidth: 80 (default) |
=====================================input======================================
value /* before */ ! /* after */;

foo!.bar() /* before */ !.baz();

const result = (/* leading */ value /* trailing */)!;

=====================================output=====================================
value /* before */!; /* after */

foo!
  .bar() /* before */!
  .baz();

const result = /* leading */ value /* trailing */!;

================================================================================
`;

exports[`comments.ts format[hermes] 1`] = `
"';' expected (1:20)
> 1 | value /* before */ ! /* after */;
    |                    ^
  2 |
  3 | foo!.bar() /* before */ !.baz();
  4 |
Cause: ';' expected (1:19)
value /* before */ ! /* after */;
                   ^"
`;

exports[`member-chain.ts format 1`] = `
====================================options=====================================
parsers: ["typescript", "flow"]
                                                      printWidth: 80 (default) |
=====================================input======================================
const { somePropThatHasAReallyLongName, anotherPropThatHasALongName } = this.props.imReallySureAboutThis!;

const { somePropThatHasAReallyLongName2, anotherPropThatHasALongName2 } = this.props.imReallySureAboutThis!.anotherObject;

this.foo.get("bar")!.doThings().more();

foo!.bar().baz().what();

xyz.a(b).a(b).a(b)
xyz.a(b!).a(b!).a(b!)
xyz.a(/a/).a(/a/).a(/a/)
xyz.a(/a/!).a(/a/!).a(/a/!)

=====================================output=====================================
const { somePropThatHasAReallyLongName, anotherPropThatHasALongName } =
  this.props.imReallySureAboutThis!;

const { somePropThatHasAReallyLongName2, anotherPropThatHasALongName2 } =
  this.props.imReallySureAboutThis!.anotherObject;

this.foo.get("bar")!.doThings().more();

foo!.bar().baz().what();

xyz.a(b).a(b).a(b);
xyz.a(b!).a(b!).a(b!);
xyz.a(/a/).a(/a/).a(/a/);
xyz.a(/a/!).a(/a/!).a(/a/!);

================================================================================
`;

exports[`member-chain.ts format[hermes] 1`] = `
"';' expected (1:105)
> 1 | const { somePropThatHasAReallyLongName, anotherPropThatHasALongName } = this.props.imReallySureAboutThis!;
    |                                                                                                         ^
  2 |
  3 | const { somePropThatHasAReallyLongName2, anotherPropThatHasALongName2 } = this.props.imReallySureAboutThis!.anotherObject;
  4 |
Cause: ';' expected (1:104)
const { somePropThatHasAReallyLongName, anotherPropThatHasALongName } = this.props.imReallySureAboutThis!;
                                                                                                        ^"
`;

exports[`optional-chain.ts format 1`] = `
====================================options=====================================
parsers: ["typescript", "flow"]
                                                      printWidth: 80 (default) |
=====================================input======================================
a?.b!.c;
a?.b!.c.d;
a?.b.c!.d;
a!.b?.c;
a?.b!?.c;
a?.b!.c?.c;
(a?.b!).c;
(a?.b)!.c;

a?.().b!.c;
a?.().b!.c.d;
a?.().b.c!.d;
a?.().b!?.c;
a?.().b!.c?.c;
(a?.().b!).c;
(a?.().b)!.c;

(a?.b)![c?.d!];

(a?.b!!)!!.c;

=====================================output=====================================
a?.b!.c;
a?.b!.c.d;
a?.b.c!.d;
a!.b?.c;
a?.b!?.c;
a?.b!.c?.c;
(a?.b!).c;
(a?.b)!.c;

a?.().b!.c;
a?.().b!.c.d;
a?.().b.c!.d;
a?.().b!?.c;
a?.().b!.c?.c;
(a?.().b!).c;
(a?.().b)!.c;

(a?.b)![c?.d!];

(a?.b!!)!!.c;

================================================================================
`;

exports[`optional-chain.ts format[hermes] 1`] = `
"';' expected (1:5)
> 1 | a?.b!.c;
    |     ^
  2 | a?.b!.c.d;
  3 | a?.b.c!.d;
  4 | a!.b?.c;
Cause: ';' expected (1:4)
a?.b!.c;
    ^"
`;

exports[`parens.ts format 1`] = `
====================================options=====================================
parsers: ["typescript", "flow"]
                                                      printWidth: 80 (default) |
=====================================input======================================
(a ? b : c) ![tokenKey];
(a || b) ![tokenKey];
(void 0)!;

async function f() {
    return (await foo())!;
}

function* g() {
    return (yield * foo())!;
}

const a = (b()!)(); // parens aren't necessary
const b = c!();

// parens are necessary if the expression result is called as a constructor
const c1 = new (d()!)();
const c2 = new (d()!);
const c3 = new (d()!.e)();
new (x()\`\`.y!)();
new (x()\`\`!.y)();
new (x()!\`\`.y)();
new (x!()\`\`.y)();

xyz.a(b!).a(b!).a(b!)

=====================================output=====================================
(a ? b : c)![tokenKey];
(a || b)![tokenKey];
(void 0)!;

async function f() {
  return (await foo())!;
}

function* g() {
  return (yield* foo())!;
}

const a = b()!(); // parens aren't necessary
const b = c!();

// parens are necessary if the expression result is called as a constructor
const c1 = new (d()!)();
const c2 = new (d()!)();
const c3 = new (d()!.e)();
new (x()\`\`.y!)();
new (x()\`\`!.y)();
new (x()!\`\`.y)();
new (x!()\`\`.y)();

xyz.a(b!).a(b!).a(b!);

================================================================================
`;

exports[`parens.ts format[hermes] 1`] = `
"';' expected (1:13)
> 1 | (a ? b : c) ![tokenKey];
    |             ^
  2 | (a || b) ![tokenKey];
  3 | (void 0)!;
  4 |
Cause: ';' expected (1:12)
(a ? b : c) ![tokenKey];
            ^"
`;
