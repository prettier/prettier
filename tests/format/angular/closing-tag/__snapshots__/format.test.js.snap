exports[`after-interpolation.html - {"htmlWhitespaceSensitivity":"strict"} format 1`] = `
====================================options=====================================
htmlWhitespaceSensitivity: "strict"
parsers: ["angular"]
                                                      printWidth: 80 (default) |
=====================================input======================================
<div>
  <div><span>{{x}}</span>.</div>
</div>
<div>
  <span><span>{{x}}</span>.</span>
</div>

<div>
  <div><span>{{long_long_long_long_long_long_long_long_expression}}</span>long_long_long_long_long_long_long_long_text</div>
</div>
<div>
  <span><span>{{long_long_long_long_long_long_long_long_expression}}</span>long_long_long_long_long_long_long_long_text</span>
</div>

<div>
  <div>long_long_long_long_long_long_long_long_text<span>{{long_long_long_long_long_long_long_long_expression}}</span></div>
</div>
<div>
  <span>long_long_long_long_long_long_long_long_text<span>{{long_long_long_long_long_long_long_long_expression}}</span></span>
</div>

=====================================output=====================================
<div>
  <div
    ><span>{{ x }}</span>.</div
  >
</div>
<div>
  <span
    ><span>{{ x }}</span>.</span
  >
</div>

<div>
  <div
    ><span>{{ long_long_long_long_long_long_long_long_expression }}</span
    >long_long_long_long_long_long_long_long_text</div
  >
</div>
<div>
  <span
    ><span>{{ long_long_long_long_long_long_long_long_expression }}</span
    >long_long_long_long_long_long_long_long_text</span
  >
</div>

<div>
  <div
    >long_long_long_long_long_long_long_long_text<span>{{
      long_long_long_long_long_long_long_long_expression
    }}</span></div
  >
</div>
<div>
  <span
    >long_long_long_long_long_long_long_long_text<span>{{
      long_long_long_long_long_long_long_long_expression
    }}</span></span
  >
</div>

================================================================================
`;

