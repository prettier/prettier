@if (users$ | async; as users) {
  {{ users.length }}
} @else if (users$ | async; as users) {
  {{ users.length }}
}

<div *ngIf="users$ | async; as users">{{ users.length }}</div>

@else {}

@if (isDev) {
} @else if (test) {}

@if (foo("quotes")) {
} @else if (foo("quotes")) {}

@if (
  widthCategory !== undefined && widthCategory > topStartToSideStartMaxSize
) {
  <app-component />
