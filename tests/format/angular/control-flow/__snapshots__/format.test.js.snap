@else if (foo(     'quotes')) {}

@if ( widthCategory !== undefined && widthCategory >
topStartToSideStartMaxSize) {
<app-component />
}

@if ( widthCategory; as item) {
}

<div *ngIf="widthCategory; as item"></div>

