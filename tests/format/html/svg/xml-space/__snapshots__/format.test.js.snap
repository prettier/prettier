// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`embedded.html format 1`] = `
====================================options=====================================
parsers: ["html", "angular"]
                                                      printWidth: 80 (default) |
=====================================input======================================
<svg>
  <script xml:space="preserve">const   label="a  b"</script>
  <style xml:space="preserve">text{  fill:  red }</style>
  <script>const   label="a  b"</script>
  <style>text{  fill:  red }</style>
  <foreignObject><div xmlns="http://www.w3.org/1999/xhtml" xml:space="preserve">  text   <b>  spaces  </b>  </div></foreignObject>
</svg>

<svg xml:space="preserve"><script>const   label="a  b"</script><style>text{  fill:  red }</style></svg>
<script xml:space="preserve">const   label="a  b"</script>

=====================================output=====================================
<svg>
  <script xml:space="preserve">const   label="a  b"</script>
  <style xml:space="preserve">text{  fill:  red }</style>
  <script>
    const label = "a  b";
  </script>
  <style>
    text {
      fill: red;
    }
  </style>
  <foreignObject
    ><div
      xmlns="http://www.w3.org/1999/xhtml"
      xml:space="preserve"
    >  text   <b>  spaces  </b>  </div></foreignObject
  >
</svg>

<svg
  xml:space="preserve"
><script>const   label="a  b"</script><style>text{  fill:  red }</style></svg>
<script xml:space="preserve">
  const label = "a  b";
</script>

================================================================================
`;

