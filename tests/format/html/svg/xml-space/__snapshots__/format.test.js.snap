exports[`nested.html format 1`] = `
====================================options=====================================
parsers: ["html", "angular"]
                                                      printWidth: 80 (default) |
=====================================input======================================
<svg xml:space="preserve"><text>before  <tspan xml:space="default">default   spaces <tspan xml:space="preserve">preserved   again</tspan></tspan>  after</text></svg>

<svg xml:space="default">
<text xml:space="preserve">  before <tspan>nested   text</tspan> after  </text>
<text xml:space="default">  default   spaces  </text>
<text>  ordinary   spaces  </text>
</svg>

=====================================output=====================================
<svg
  xml:space="preserve"
><text>before  <tspan xml:space="default">default   spaces <tspan xml:space="preserve">preserved   again</tspan></tspan>  after</text></svg>

<svg xml:space="default">
  <text
    xml:space="preserve"
  >  before <tspan>nested   text</tspan> after  </text>
  <text xml:space="default">default spaces</text>
  <text>ordinary spaces</text>
</svg>

================================================================================
`;

exports[`not-preserved.html format 1`] = `
====================================options=====================================
parsers: ["html", "angular"]
                                                      printWidth: 80 (default) |
=====================================input======================================
<svg>
  <text>  ordinary   spaces  </text>
  <text xml:space="default">  default   spaces  </text>
  <text xml:space="normalize">  invalid   value  </text>
  <text xml:space="PRESERVE">  uppercase   value  </text>
</svg>

<div xml:space="preserve">  ordinary   HTML <span>  content  </span> after  </div>
<math><mtext xml:space="preserve">  ordinary   MathML  </mtext></math>

=====================================output=====================================
<svg>
  <text>ordinary spaces</text>
  <text xml:space="default">default spaces</text>
  <text xml:space="normalize">invalid value</text>
  <text xml:space="PRESERVE">uppercase value</text>
</svg>

<div xml:space="preserve">ordinary HTML <span> content </span> after</div>
<math><mtext xml:space="preserve"> ordinary MathML </mtext></math>

================================================================================
`;

exports[`preserve.html format 1`] = `
====================================options=====================================
parsers: ["html", "angular"]
                                                      printWidth: 80 (default) |
=====================================input======================================
<svg>
  <text xml:space="preserve">  one   <tspan>  two </tspan> three  </text>
  <g xml:space="preserve"><text>  inherited   <tspan> spaces </tspan>  </text></g>
  <text xml:space="preserve"></text>
  <text xml:space="preserve" />
  <text xml:space="preserve"> 
 	 </text>
  <text xml:space="preserve">before  <!-- comment -->  <![CDATA[  inside   ]]><tspan> after  </tspan> end</text>
</svg>

<svg:svg><svg:text xml:space="preserve">  explicit   namespace  </svg:text></svg:svg>

=====================================output=====================================
<svg>
  <text xml:space="preserve">  one   <tspan>  two </tspan> three  </text>
  <g
    xml:space="preserve"
  ><text>  inherited   <tspan> spaces </tspan>  </text></g>
  <text xml:space="preserve"></text>
  <text xml:space="preserve" />
  <text xml:space="preserve"> 
 	 </text>
  <text
    xml:space="preserve"
  >before  <!-- comment -->  <![CDATA[  inside   ]]><tspan> after  </tspan> end</text>
</svg>

<svg:svg>
  <svg:text xml:space="preserve">  explicit   namespace  </svg:text>
</svg:svg>

================================================================================
`;
